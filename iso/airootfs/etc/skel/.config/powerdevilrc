# Live-сессия: экран не тускнеет, не гаснет и компьютер не засыпает —
# установка идёт долго, и человек может отойти. В установленной системе
# остаются обычные настройки Plasma.
[AC][Display]
DimDisplayWhenIdle=false
TurnOffDisplayWhenIdle=false

[AC][SuspendAndShutdown]
AutoSuspendAction=0

[Battery][Display]
DimDisplayWhenIdle=false
TurnOffDisplayWhenIdle=false

[Battery][SuspendAndShutdown]
AutoSuspendAction=0

[LowBattery][Display]
DimDisplayWhenIdle=false
TurnOffDisplayWhenIdle=false

[LowBattery][SuspendAndShutdown]
AutoSuspendAction=0
