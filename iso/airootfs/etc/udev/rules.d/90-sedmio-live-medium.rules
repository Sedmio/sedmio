# Live-система: прячем от udisks загрузочный носитель (сам образ и его
# EFI-раздел). Его нельзя извлекать, пока работает live-система, и он не
# должен всплывать в Plasma «Дисках и устройствах», когда установщик
# размечает диск и udev заново объявляет все устройства.
ENV{ID_FS_LABEL}=="SEDMIO_*", ENV{UDISKS_IGNORE}="1"
ENV{ID_FS_LABEL}=="ARCHISO_EFI", ENV{UDISKS_IGNORE}="1"
