# Maintainer: Sedmio <https://github.com/Sedmio>
#
# ПК: Ryzen 7 7700 (Zen 4), RTX 4060 + встроенная Radeon.
# Монитор подключён к NVIDIA. Встроенная Radeon остаётся включённой
# как запасной видеовыход на случай поломки драйвера NVIDIA.
#
# Требует репозиториев CachyOS (linux-cachyos*) и [multilib] (lib32-*).

pkgname=sedmio-host-desktop
pkgver=0.1.0
pkgrel=1
pkgdesc="Sedmio: профиль ПК (Ryzen 7 7700 + RTX 4060)"
arch=('any')
url="https://github.com/Sedmio/sedmio"
license=('MIT')
depends=(
  'sedmio-base'

  # Ядра: основное CachyOS + запасное LTS из Arch
  'linux-cachyos'
  'linux-cachyos-headers'
  'linux-cachyos-nvidia-open'
  'linux-lts'
  'linux-lts-headers'

  # NVIDIA: готовый модуль для CachyOS, DKMS для LTS
  'nvidia-open-dkms'
  'nvidia-utils'
  'lib32-nvidia-utils'

  # Встроенная Radeon
  'mesa'
  'vulkan-radeon'
)
conflicts=('sedmio-host-laptop')

package() {
  install -Dm644 "$startdir/nvidia.conf" "$pkgdir/etc/modprobe.d/sedmio-nvidia.conf"
}
