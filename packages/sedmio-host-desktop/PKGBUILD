# Maintainer: Sedmio <https://github.com/Sedmio>
#
# ПК: Ryzen 7 7700 (Zen 4), RTX 4060 + встроенная Radeon.
# Монитор подключён к NVIDIA. Встроенная Radeon остаётся включённой
# как запасной видеовыход на случай поломки драйвера NVIDIA.
#
# Требует репозиториев CachyOS (linux-cachyos*).
#
# Без заголовков ядер (*-headers): модули NVIDIA готовые, собирать на
# месте нечего, а с заголовками приезжают ещё gcc, clang и llvm (1,2 ГБ).
# Без lib32-nvidia-utils: 32-битные библиотеки (~1 ГБ) нужны только Steam
# и Wine, pacman доставит их вместе с ними ([multilib] включён). Когда он
# спросит, какой 32-битный драйвер ставить, выбрать lib32-nvidia-utils.

pkgname=sedmio-host-desktop
pkgver=0.1.0
pkgrel=4
pkgdesc="Sedmio: профиль ПК (Ryzen 7 7700 + RTX 4060)"
arch=('any')
url="https://github.com/Sedmio/sedmio"
license=('MIT')
depends=(
  'sedmio-base'

  # Ядра: основное и запасное LTS — оба от CachyOS
  'linux-cachyos'
  'linux-cachyos-lts'

  # NVIDIA: готовые модули под оба ядра. DKMS (nvidia-open-dkms)
  # конфликтует с linux-cachyos-nvidia-open и собирался бы при установке.
  # Модули и nvidia-utils — от одного поставщика: модуль Arch для linux-lts
  # (nvidia-open-lts) требовал другую версию nvidia-utils, чем модуль
  # CachyOS, и система не ставилась и не обновлялась (docs/decisions.md, п. 6).
  'linux-cachyos-nvidia-open'
  'linux-cachyos-lts-nvidia-open'
  'nvidia-utils'

  # Встроенная Radeon
  'mesa'
  'vulkan-radeon'
)
conflicts=('sedmio-host-laptop')
install=sedmio-host.install

package() {
  install -Dm644 "$startdir/nvidia.conf" "$pkgdir/etc/modprobe.d/sedmio-nvidia.conf"
}
