# Maintainer: Sedmio <https://github.com/Sedmio>
#
# Оболочка Sedmio вместо plasmashell: обои, рамка вокруг экрана, панель
# слева. Написана на Quickshell (наша сборка, packages/quickshell), лежит
# в /usr/share/sedmio/shell.
#
# Запуск — служба sedmio-shell.service в сеансе Sedmio (sedmio-session).
# Упала насовсем — аварийный режим (плашка от sedmio-session-manager).
#
# Части, которые можно выключить, — модули (usr/share/sedmio/shell/modules,
# README.md там же); переключает sedmio-modules и «Параметры» → «Модули».

pkgname=sedmio-shell
pkgver=0.1.0
pkgrel=82
pkgdesc="Sedmio: оболочка рабочего стола (панель, рамка, обои) на Quickshell"
arch=('any')
url="https://github.com/Sedmio/sedmio"
license=('MIT')
depends=(
  'quickshell>=0.3.2-19' # наша сборка: список окон под KWin, службы Plasma, буфер обмена, ход копирования, миниатюры окон, меню трея, папки модулей
  'sedmio-branding'     # шрифт Onest
  'sedmio-theme'        # цвета и прочее оформление (Sedmio.Style)
  'sedmio-settings'     # знак Sedmio в hicolor
  'sedmio-session'      # сеанс, в котором работает оболочка
  'breeze-icons'
  'qt6-svg'
  'libnotify'           # notify-send: «Выполнить» не нашёл программу
  'python'              # sedmio-modules
  'kpipewire'           # миниатюры окон (PipeWireSourceItem)
)

package() {
  cp -a "$startdir/files/." "$pkgdir/"
  find "$pkgdir" -type d -exec chmod 755 {} +
  find "$pkgdir" -type f -exec chmod 644 {} +
  chmod 755 "$pkgdir/usr/bin/sedmio-modules" "$pkgdir/usr/lib/sedmio/shell-reload" "$pkgdir/usr/lib/sedmio/open-settings" "$pkgdir/usr/lib/sedmio/launch"

  # Включена для всех пользователей в сеансе Sedmio.
  install -dm755 "$pkgdir/usr/lib/systemd/user/sedmio-session.target.wants"
  ln -s ../sedmio-shell.service "$pkgdir/usr/lib/systemd/user/sedmio-session.target.wants/sedmio-shell.service"
  ln -s ../sedmio-agents.service "$pkgdir/usr/lib/systemd/user/sedmio-session.target.wants/sedmio-agents.service"
}
