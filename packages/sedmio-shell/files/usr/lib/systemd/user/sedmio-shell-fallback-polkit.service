# Пароль администратора спрашивает наша оболочка, агент KDE отключён
# (plasma-polkit-agent.service.d/10-sedmio-shell.conf). Оболочка упала
# насовсем — запускаем агент KDE, чтобы окна «нужен пароль» работали.
# Запускается вместе с sedmio-shell-fallback.service. Без BusName: то же
# имя уже у plasma-polkit-agent.service, и systemd отказался бы запускать.
[Unit]
Description=Sedmio shell fallback: KDE polkit agent
PartOf=graphical-session.target
# Наша оболочка снова запустилась — агент KDE уходит, агент снова её.
Conflicts=sedmio-shell.service

[Service]
ExecStart=/usr/lib/polkit-kde-authentication-agent-1
Slice=background.slice
TimeoutStopSec=5sec
Restart=on-failure
