# Запасная оболочка: наша (sedmio-shell.service) упала трижды за минуту
# и systemd её больше не перезапускает — например, после сломанного
# обновления. Тогда поднимаем plasmashell, чтобы не остаться без панели,
# меню и уведомлений, и говорим об этом. Окна паролей живут отдельно
# (sedmio-agents.service) и работают дальше. Запускается только по OnFailure
# из sedmio-shell.service; до следующего входа в сеанс.
[Unit]
Description=Sedmio shell fallback: plasmashell
PartOf=graphical-session.target
# Нашу оболочку запустили снова (systemctl --user start) — запасная уходит.
Conflicts=sedmio-shell.service

[Service]
# Наш пакет Plasma/Shell (org.sedmio.shell, sedmio-login) — только экраны
# блокировки и выхода, рабочего стола в нём нет.
Environment=PLASMA_DEFAULT_SHELL=org.kde.plasma.desktop
# Агент паролей Wi‑Fi из plasma-nm — для апплета сети plasmashell
# (при нашей оболочке не загружается, /etc/xdg/kded5rc).
ExecStartPre=-/usr/bin/busctl --user call org.kde.kded6 /kded org.kde.kded6 loadModule s networkmanagement
ExecStart=/usr/bin/plasmashell --no-respawn
ExecStartPost=-/bin/sh -c 'sleep 6; notify-send -u critical -a Sedmio -i dialog-warning "Оболочка Sedmio не запустилась" "Временно включена стандартная оболочка Plasma. Перезайдите в сеанс, чтобы попробовать снова."'
Restart=on-failure
Slice=session.slice
