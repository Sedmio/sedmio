[Unit]
Description=Sedmio shell: panel, screen frame and wallpaper
Documentation=https://github.com/Sedmio/sedmio
After=plasma-ksmserver.service plasma-kwin_wayland.service
PartOf=graphical-session.target
# Вернуться к plasmashell: touch ~/.config/sedmio/use-plasmashell
ConditionPathExists=!%h/.config/sedmio/use-plasmashell
StartLimitIntervalSec=60s
StartLimitBurst=3
# Упала насовсем — запасная оболочка (plasmashell и агент polkit KDE).
OnFailure=sedmio-shell-fallback.service

[Service]
# Плашки Quickshell о перезагрузке настроек — для разработчика, не для нас.
Environment=QS_NO_RELOAD_POPUP=1
# Без обработчика падений Quickshell (окно «has crashed» по-английски и
# самоперезапуск мимо systemd — тогда не срабатывают счётчик и OnFailure).
# Пакет quickshell собран без него, это — на случай другой сборки.
Environment=QS_DISABLE_CRASH_HANDLER=1
ExecStart=/usr/bin/quickshell --path /usr/share/sedmio/shell
Restart=on-failure
Slice=session.slice

[Install]
WantedBy=plasma-core.target
