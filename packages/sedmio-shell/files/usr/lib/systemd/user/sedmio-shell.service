[Unit]
Description=Sedmio shell: panel, screen frame and wallpaper
Documentation=https://github.com/Sedmio/sedmio
After=sedmio-kwin.service
PartOf=graphical-session.target
StartLimitIntervalSec=60s
StartLimitBurst=3
# Упала насовсем (три раза за минуту) — аварийный режим: плашку с
# перезапуском показывает sedmio-session-manager (пакет sedmio-session).

[Service]
# Плашки Quickshell о перезагрузке настроек — для разработчика, не для нас.
Environment=QS_NO_RELOAD_POPUP=1
# Без обработчика падений Quickshell (окно «has crashed» по-английски и
# самоперезапуск мимо systemd — тогда не срабатывает счётчик падений).
# Пакет quickshell собран без него, это — на случай другой сборки.
Environment=QS_DISABLE_CRASH_HANDLER=1
ExecStart=/usr/bin/quickshell --path /usr/share/sedmio/shell
Restart=on-failure
Slice=session.slice

[Install]
WantedBy=sedmio-session.target
