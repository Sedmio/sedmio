# Панель выбора эмодзи Plasma: в Sedmio не нужна. Она из пакета
# plasma-desktop, поэтому только прячем из списка программ (перекрывает
# /usr/share/applications: XDG_DATA_DIRS из environment.d), а клавиши
# Meta+. снимаем в ../kglobalaccel/.
[Desktop Entry]
Type=Application
Name=Emoji Selector
Name[ru]=Панель выбора эмодзи
Exec=plasma-emojier
Icon=preferences-desktop-emoticons
NoDisplay=true
