# Оболочка Sedmio или окна паролей обновились — перечитать в открытых сеансах разом,
# после всей транзакции (usr/lib/sedmio/shell-reload).
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/share/sedmio/shell/*
Target = usr/share/sedmio/agents/*
# Сам Quickshell: оболочку и окна паролей перезапустить на новом (shell-reload).
Target = usr/bin/quickshell

[Action]
Description = Перезагрузка оболочки Sedmio в открытых сеансах...
When = PostTransaction
Exec = /usr/lib/sedmio/shell-reload
