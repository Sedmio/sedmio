# Глобальные клавиши панели управления Sedmio (как Win+A в Windows 11).
# Как устроено — в sedmio-launcher.desktop рядом.
[Desktop Entry]
Type=Application
Name=Sedmio control panel
Name[ru]=Панель управления Sedmio
Icon=preferences-system
Exec=quickshell ipc -p /usr/share/sedmio/shell call control toggle
X-KDE-Shortcuts=Meta+A
