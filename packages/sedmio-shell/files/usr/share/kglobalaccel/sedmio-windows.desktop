# Meta+1…9 — программа с этим номером на панели (как в Windows; в Plasma
# эти клавиши были у панели задач plasmashell). Как устроено — в
# sedmio-launcher.desktop рядом. Оболочка не запущена — клавиши ничего
# не делают (у запасного plasmashell они заняты нами).
[Desktop Entry]
Type=Application
Name=Sedmio windows
Name[ru]=Окна на панели Sedmio
Icon=sedmio
Exec=quickshell ipc -p /usr/share/sedmio/shell call windows activate 1
X-KDE-Shortcuts=Meta+1
Actions=2;3;4;5;6;7;8;9;

[Desktop Action 2]
Name=Program 2 on the panel
Name[ru]=Программа 2 на панели
Exec=quickshell ipc -p /usr/share/sedmio/shell call windows activate 2
X-KDE-Shortcuts=Meta+2

