# Установка пакетов на размеченный диск (pacstrap) с видимым ходом:
# полоса и подпись показывают, сколько скачано и что ставится сейчас.
# Работу делает /usr/lib/sedmio/installer/pacstrap.sh, модуль читает
# его вывод построчно.
---
type: "job"
name: "sedmiopacstrap"
interface: "python"
script: "main.py"
noconfig: true
# Самый долгий шаг: пусть занимает большую часть общей полосы хода,
# а не 1/30, как остальные.
weight: 60
