# Maintainer: Sedmio <https://github.com/Sedmio>
#
# «Диспетчер задач» (Ctrl+Shift+Esc): открытые программы — по их группам
# systemd (процессор, память, «Завершить», «Закрыть принудительно»), части
# системы отдельно, перезапуск и запуск упавшей оболочки, «Запустить новую
# задачу» (программа без оболочки — вместо KRunner). Отдельный пакет,
# а не раздел «Параметров»: инструмент на случай, когда что-то сломалось,
# не должен ломаться вместе с остальным. Зависит только от Qt и KDE
# Frameworks (KService, KCoreAddons, KWindowSystem);
# цвета — общий модуль Sedmio.Style (sedmio-theme), файлы
# оформления (и поле ввода) — копия из sedmio-preferences.
#
# Ctrl+Shift+Esc — X-KDE-Shortcuts в .desktop; файл для kglobalaccel —
# ссылка files/usr/share/kglobalaccel/sedmio-tasks.desktop.
#
# Исходники — app/ рядом с этим файлом (src/ занята makepkg).

pkgname=sedmio-tasks
pkgver=0.1.0
pkgrel=5
pkgdesc="Sedmio: диспетчер задач"
arch=('x86_64')
url="https://github.com/Sedmio/sedmio"
license=('MIT')
depends=(
  'qt6-base'
  'qt6-declarative'
  'kservice'
  'kcoreaddons'     # KShell: разбор команды в «Запустить новую задачу»
  'kwindowsystem'
  'systemd'         # группы программ (cgroup), остановка через systemd --user
  # Шрифт Onest (sedmio-branding) и цвета (sedmio-theme, модуль Sedmio.Style)
  # сюда не вписаны: makepkg ставит зависимости компилируемого пакета на
  # машину сборки, а наших пакетов в репозиториях Arch нет. Их тянет
  # sedmio-base.
  'breeze-icons'
)
makedepends=(
  'cmake'
  'ninja'
)

build() {
  cmake -G Ninja -S "$startdir/app" -B build -W no-dev \
    -D CMAKE_BUILD_TYPE=RelWithDebInfo \
    -D CMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  cp -a "$startdir/files/." "$pkgdir/"
}
