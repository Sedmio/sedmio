# Win+↑ / Win+↓, Win+Tab, Alt+F4 и Ctrl+F1…F4 как в Windows для каждого пользователя — один раз
# (kconf_update помнит Id в ~/.config/kconf_updaterc). Пакет sedmio-settings.
Version=6

# -2: добавился Win+Tab, -3: Alt+F4, -4: Ctrl+F1…F4; повтор безопасен —
# трогает только сочетания по умолчанию.
Id=sedmio-windowkeys-4
Script=sedmio-windowkeys.sh,sh
