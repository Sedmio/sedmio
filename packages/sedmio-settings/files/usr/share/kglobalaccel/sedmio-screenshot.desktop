# Глобальные клавиши снимка экрана: kglobalaccel читает файлы из этого
# каталога при старте сеанса и выполняет Exec по клавише. Не в
# /usr/share/applications — в меню и «Открыть с помощью» не попадает;
# NoDisplay ставить нельзя: такие файлы kglobalaccel отключает.
# Клавиши отдаёт ему kconf_update sedmio-screenshotkeys: по умолчанию их
# держит Spectacle (открывает своё окно).
[Desktop Entry]
Type=Application
Name=Screenshot of an area
Name[ru]=Снимок области экрана
Icon=org.kde.spectacle
Exec=/usr/lib/sedmio/screenshot
X-KDE-Shortcuts=Print,Meta+Shift+S
Actions=Screen;Window;

[Desktop Action Screen]
Name=Screenshot of the whole screen
Name[ru]=Снимок всего экрана
Exec=/usr/lib/sedmio/screenshot screen
X-KDE-Shortcuts=Meta+Print

# Alt+PrtSc: xkb выдаёт на PrtSc с Alt клавишу Sys_Req (а многие клавиатуры
# и сами шлют SysRq) — нужны оба сочетания.
[Desktop Action Window]
Name=Screenshot of the active window
Name[ru]=Снимок активного окна
Exec=/usr/lib/sedmio/screenshot window
X-KDE-Shortcuts=Alt+Print,Alt+SysReq
