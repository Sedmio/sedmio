[KDE]
# Одинарный клик выделяет, двойной открывает
SingleClick=false

[General]
# Цвета Sedmio (usr/share/color-schemes/Sedmio.colors). Сами цвета в
# ~/.config/kdeglobals переносит sedmio-theme-sync (пакет sedmio-theme).
# Его нет — цвета Breeze.
ColorScheme=Sedmio

[Icons]
# Breeze с белыми знаками на папках (usr/share/icons/sedmio, собирается из
# Breeze при сборке пакета: icons/make-theme.py). Нет темы — Breeze.
# Пользователям, у которых раньше был сеанс Plasma (он писал
# ~/.config/kdedefaults), тему ставит и kconf_update (sedmio-icons.upd).
Theme=sedmio
