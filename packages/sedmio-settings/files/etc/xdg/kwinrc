[Windows]
# 0 = без защиты от кражи фокуса: новое окно сразу активно, как в Windows
FocusStealingPreventionLevel=0

[Wayland]
# Выделение текста не копирует, средняя кнопка не вставляет.
# Проверить на живой системе, совпадает ли ключ с настройкой в GUI.
EnablePrimarySelection=false

[TabBox]
# Alt+Tab — свой переключатель (пакет sedmio-shell,
# usr/share/kwin/tabbox/org.sedmio.switcher). Нет пакета — KWin берёт свой.
LayoutName=org.sedmio.switcher
# Без «подсветки окна»: она гасит всё, кроме выбранного окна, и панель
# оболочки тоже; в Windows Alt+Tab так не делает.
HighlightWindows=false

[org.kde.kdecoration2]
# Рамки окон — свои, по теме Sedmio (пакет sedmio-theme,
# org.kde.kdecoration3/org.sedmio.decoration.so). Нет плагина — KWin
# рисует Breeze.
library=org.sedmio.decoration
# Слева значок программы (меню окна), справа свернуть, развернуть, закрыть.
ButtonsOnLeft=M
ButtonsOnRight=IAX
