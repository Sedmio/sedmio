 void ProxyWindowBase::onReload(QObject* oldInstance) {
 	if (this->mVisible) this->window = this->retrieveWindow(oldInstance);
+
+	// The old window is on another screen, and windows that are recreated whenever
+	// hidden (layershell, popups) can't be moved: hiding counts as closing. Drop it
+	// and make a fresh one on the right screen, as on first load.
+	if (this->window != nullptr && this->deleteOnInvisible() && this->mScreen != nullptr
+	    && this->window->screen() != this->mScreen)
+	{
+		auto* old = this->window;
+		this->window = nullptr;
+		old->setVisible(false);
+		old->deleteLater();
+	}
+
 	auto wasVisible = this->window != nullptr && this->window->isVisible();
 
 	if (this->mVisible) this->ensureQWindow();
@@ -222,7 +235,16 @@
 
 void ProxyWindowBase::completeWindow() {
 	if (this->mScreen != nullptr && this->window->screen() != this->mScreen) {
-		if (this->window->isVisible()) this->window->setVisible(false);
+		if (this->window->isVisible()) {
+			// Hiding only to move the window to another screen (reload) is not a close:
+			// onVisibleChanged would drop mVisible and the window would stay hidden
+			// (or, for windows recreated when hidden, be deleted under us — those are
+			// replaced in onReload instead and never get here visible).
+			this->mMovingScreen = true;
+			this->window->setVisible(false);
+			this->mMovingScreen = false;
+			if (this->window == nullptr) return;
+		}
 		this->window->setScreen(this->mScreen);
 	}
 
