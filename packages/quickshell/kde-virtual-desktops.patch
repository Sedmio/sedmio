+
+VirtualDesktopManager* VirtualDesktopManager::instance() {
+	static auto* instance = new VirtualDesktopManager(); // NOLINT
+	return instance;
+}
+
+void VirtualDesktopManager::setCurrent(const QString& id) {
+	if (id == this->mCurrent) return;
+	this->mCurrent = id;
+	emit this->currentChanged();
+}
+
+void VirtualDesktopManager::org_kde_plasma_virtual_desktop_management_desktop_created(
+    const QString& id,
+    uint32_t /*position*/
+) {
+	if (this->mDesktops.contains(id)) return;
+	auto* desktop = new VirtualDesktop(this, id);
+	desktop->init(this->get_virtual_desktop(id));
+	this->mDesktops.insert(id, desktop);
+}
+
+void VirtualDesktopManager::org_kde_plasma_virtual_desktop_management_desktop_removed(
+    const QString& id
+) {
+	delete this->mDesktops.take(id);
+	if (id == this->mCurrent) this->setCurrent(QString());
+}
+
+VirtualDesktop::VirtualDesktop(VirtualDesktopManager* manager, QString id)
+    : QObject(manager)
