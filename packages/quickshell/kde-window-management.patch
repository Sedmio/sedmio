diff --git a/src/wayland/toplevel/handle.hpp b/src/wayland/toplevel/handle.hpp
new file mode 100644
index 0000000..ebd50fa
--- /dev/null
+++ b/src/wayland/toplevel/handle.hpp
@@ -0,0 +1,56 @@
+#pragma once
+
+#include <qlist.h>
+#include <qobject.h>
+#include <qrect.h>
+#include <qscreen.h>
+#include <qstring.h>
+#include <qtmetamacros.h>
+#include <qwindow.h>
+
+namespace qs::wayland::toplevel::impl {
+
+// A window from another application, as reported by one of the supported
+// protocols: wlr-foreign-toplevel-management (wlroots compositors, Hyprland)
+// or org_kde_plasma_window_management (KWin). The QML Toplevel wraps this
+// and does not care which protocol is behind it.
+class ToplevelHandle: public QObject {
+	Q_OBJECT;
+
+public:
+	explicit ToplevelHandle(QObject* parent = nullptr): QObject(parent) {}
+
+	[[nodiscard]] virtual QString appId() const = 0;
+	[[nodiscard]] virtual QString title() const = 0;
+	[[nodiscard]] virtual ToplevelHandle* parentToplevel() const = 0;
+	[[nodiscard]] virtual bool activated() const = 0;
+	[[nodiscard]] virtual bool maximized() const = 0;
+	[[nodiscard]] virtual bool minimized() const = 0;
+	[[nodiscard]] virtual bool fullscreen() const = 0;
+	[[nodiscard]] virtual QList<QScreen*> screens() const = 0;
+
+	virtual void activate() = 0;
+	virtual void close() = 0;
+	virtual void setMaximized(bool maximized) = 0;
+	virtual void setMinimized(bool minimized) = 0;
+	virtual void setFullscreen(bool fullscreen) = 0;
+	virtual void fullscreenOn(QScreen* screen) = 0;
+	virtual void setRectangle(QWindow* window, QRect rect) = 0;
+
+signals:
+	// sent once the initial state is known.
+	void ready();
+	// sent right before delete this.
+	void closed();
+
+	void appIdChanged();
+	void titleChanged();
+	void parentChanged();
+	void activatedChanged();
+	void maximizedChanged();
+	void minimizedChanged();
+	void fullscreenChanged();
+	void screensChanged();
+};
+
+} // namespace qs::wayland::toplevel::impl
diff --git a/src/wayland/toplevel/kde_toplevel.cpp b/src/wayland/toplevel/kde_toplevel.cpp
new file mode 100644
index 0000000..ec77431
--- /dev/null
+++ b/src/wayland/toplevel/kde_toplevel.cpp
@@ -0,0 +1,281 @@
+#include "kde_toplevel.hpp"
+#include <algorithm>
+#include <cstdint>
+
+#include <private/qwaylandscreen_p.h>
+#include <private/qwaylandwindow_p.h>
+#include <qguiapplication.h>
+#include <qlogging.h>
+#include <qloggingcategory.h>
+#include <qobject.h>
+#include <qscreen.h>
+#include <qtmetamacros.h>
+#include <qwaylandclientextension.h>
+#include <wayland-client-protocol.h>
+
+#include "../../core/logcat.hpp"
+#include "qwayland-plasma-window-management.h"
+#include "wayland-plasma-window-management-client-protocol.h"
+
+namespace qs::wayland::toplevel::kde {
+
+QS_LOGGING_CATEGORY(logKdeToplevel, "quickshell.wayland.kdeToplevel", QtWarningMsg);
+
+namespace {
+
+constexpr uint32_t STATE_ACTIVE = ORG_KDE_PLASMA_WINDOW_MANAGEMENT_STATE_ACTIVE;
+constexpr uint32_t STATE_MINIMIZED = ORG_KDE_PLASMA_WINDOW_MANAGEMENT_STATE_MINIMIZED;
+constexpr uint32_t STATE_MAXIMIZED = ORG_KDE_PLASMA_WINDOW_MANAGEMENT_STATE_MAXIMIZED;
+constexpr uint32_t STATE_FULLSCREEN = ORG_KDE_PLASMA_WINDOW_MANAGEMENT_STATE_FULLSCREEN;
+constexpr uint32_t STATE_SKIPTASKBAR = ORG_KDE_PLASMA_WINDOW_MANAGEMENT_STATE_SKIPTASKBAR;
+
+// window_with_uuid and get_window_by_uuid need 13, send_to_output 15.
+// Newer versions change how windows are announced (mapped, stacking order
+// objects) and bring nothing a taskbar needs.
+constexpr int MANAGER_VERSION = 16;
+constexpr uint32_t SEND_TO_OUTPUT_SINCE = 15;
+
+} // namespace
+
+ToplevelManager::ToplevelManager(): QWaylandClientExtensionTemplate(MANAGER_VERSION) {
+	this->initialize();
+}
+
+bool ToplevelManager::available() const { return this->isActive(); }
+
+const QVector<ToplevelHandle*>& ToplevelManager::readyToplevels() const {
+	return this->mReadyToplevels;
+}
+
+ToplevelHandle* ToplevelManager::handleFor(::org_kde_plasma_window* window) {
+	if (window == nullptr) return nullptr;
+
+	for (auto* other: this->mToplevels) {
+		if (other->object() == window) return other;
+	}
+
+	return nullptr;
+}
+
+ToplevelManager* ToplevelManager::instance() {
+	static auto* instance = new ToplevelManager(); // NOLINT
+	return instance;
+}
+
+void ToplevelManager::org_kde_plasma_window_management_window_with_uuid(
+    uint32_t /*id*/,
+    const QString& uuid
+) {
+	auto* handle = new ToplevelHandle();
+	QObject::connect(handle, &ToplevelHandle::closed, this, &ToplevelManager::onToplevelClosed);
+	QObject::connect(handle, &ToplevelHandle::ready, this, &ToplevelManager::onToplevelReady);
+
+	qCDebug(logKdeToplevel) << "Window" << uuid << "announced as" << handle;
+	this->mToplevels.push_back(handle);
+
+	// Not done in the constructor: the window could be unmapped right away,
+	// and touching the handle after that would be a use after free.
+	handle->init(this->get_window_by_uuid(uuid));
+}
+
+void ToplevelManager::onToplevelReady() {
+	auto* handle = qobject_cast<ToplevelHandle*>(this->sender());
+	this->mReadyToplevels.push_back(handle);
+	emit this->toplevelReady(handle);
+}
+
+void ToplevelManager::onToplevelClosed() {
+	auto* handle = qobject_cast<ToplevelHandle*>(this->sender());
+	this->mReadyToplevels.removeOne(handle);
+	this->mToplevels.removeOne(handle);
+}
+
+ToplevelHandle::ToplevelHandle() {
+	auto* app = qGuiApp;
+	QObject::connect(app, &QGuiApplication::screenAdded, this, &ToplevelHandle::updateScreens);
+	QObject::connect(app, &QGuiApplication::screenRemoved, this, &ToplevelHandle::updateScreens);
+}
+
+ToplevelHandle::~ToplevelHandle() {
+	if (this->isInitialized()) this->destroy();
+}
+
+QString ToplevelHandle::appId() const { return this->mAppId; }
+QString ToplevelHandle::title() const { return this->mTitle; }
+impl::ToplevelHandle* ToplevelHandle::parentToplevel() const { return this->mParent; }
+bool ToplevelHandle::activated() const { return (this->mState & STATE_ACTIVE) != 0; }
+bool ToplevelHandle::maximized() const { return (this->mState & STATE_MAXIMIZED) != 0; }
+bool ToplevelHandle::minimized() const { return (this->mState & STATE_MINIMIZED) != 0; }
+bool ToplevelHandle::fullscreen() const { return (this->mState & STATE_FULLSCREEN) != 0; }
+bool ToplevelHandle::skipTaskbar() const { return (this->mState & STATE_SKIPTASKBAR) != 0; }
+QList<QScreen*> ToplevelHandle::screens() const { return this->mScreens; }
+
+void ToplevelHandle::setState(uint32_t flag, bool on) { this->set_state(flag, on ? flag : 0); }
+
+// Activating a minimized window also restores it, as on a regular taskbar.
+void ToplevelHandle::activate() { this->setState(STATE_ACTIVE, true); }
+void ToplevelHandle::close() { this->QtWayland::org_kde_plasma_window::close(); }
+void ToplevelHandle::setMaximized(bool maximized) { this->setState(STATE_MAXIMIZED, maximized); }
+void ToplevelHandle::setMinimized(bool minimized) { this->setState(STATE_MINIMIZED, minimized); }
+
+void ToplevelHandle::setFullscreen(bool fullscreen) {
+	this->setState(STATE_FULLSCREEN, fullscreen);
+}
+
+void ToplevelHandle::fullscreenOn(QScreen* screen) {
+	auto version = wl_proxy_get_version(reinterpret_cast<wl_proxy*>(this->object())); // NOLINT
+	auto* waylandScreen =
+	    screen != nullptr ? dynamic_cast<QtWaylandClient::QWaylandScreen*>(screen->handle()) : nullptr;
+
+	if (waylandScreen != nullptr && version >= SEND_TO_OUTPUT_SINCE) {
+		this->send_to_output(waylandScreen->output());
+	}
+
+	this->setFullscreen(true);
+}
+
+// Where the window's taskbar entry is: KWin animates minimizing into it.
+void ToplevelHandle::setRectangle(QWindow* window, QRect rect) {
+	if (window == nullptr) {
+		if (this->rectWindow != nullptr) {
+			auto* waylandWindow =
+			    dynamic_cast<QtWaylandClient::QWaylandWindow*>(this->rectWindow->handle());
+
+			if (waylandWindow != nullptr && waylandWindow->surface() != nullptr) {
+				this->unset_minimized_geometry(waylandWindow->surface());
+			}
+
+			QObject::disconnect(this->rectWindow, nullptr, this, nullptr);
+			this->rectWindow = nullptr;
+		}
+
+		return;
+	}
+
+	if (this->rectWindow != window) {
+		if (this->rectWindow != nullptr) {
+			QObject::disconnect(this->rectWindow, nullptr, this, nullptr);
+		}
+
+		this->rectWindow = window;
+		QObject::connect(window, &QObject::destroyed, this, &ToplevelHandle::onRectWindowDestroyed);
+	}
+
+	auto send = [this, rect](QtWaylandClient::QWaylandWindow* waylandWindow) {
+		if (waylandWindow == nullptr || waylandWindow->surface() == nullptr) return;
+		this->set_minimized_geometry(
+		    waylandWindow->surface(),
+		    static_cast<uint32_t>(std::max(rect.x(), 0)),
+		    static_cast<uint32_t>(std::max(rect.y(), 0)),
+		    static_cast<uint32_t>(std::max(rect.width(), 0)),
+		    static_cast<uint32_t>(std::max(rect.height(), 0))
+		);
+	};
+
+	if (auto* waylandWindow = dynamic_cast<QtWaylandClient::QWaylandWindow*>(window->handle())) {
+		send(waylandWindow);
+	} else {
+		QObject::connect(window, &QWindow::visibleChanged, this, [window, send]() {
+			if (!window->isVisible()) return;
+			if (window->handle() == nullptr) window->create();
+			send(dynamic_cast<QtWaylandClient::QWaylandWindow*>(window->handle()));
+		});
+	}
+}
+
+void ToplevelHandle::onRectWindowDestroyed() { this->rectWindow = nullptr; }
+
+void ToplevelHandle::updateScreens() {
+	QList<QScreen*> screens;
+
+	if (this->mGeometry.isValid()) {
+		for (auto* screen: QGuiApplication::screens()) {
+			if (screen->geometry().intersects(this->mGeometry)) screens.push_back(screen);
+		}
+	}
+
+	if (screens != this->mScreens) {
+		this->mScreens = screens;
+		emit this->screensChanged();
+	}
+}
+
+void ToplevelHandle::updateReady() {
+	if (this->isReady || !this->initialStateReceived || this->skipTaskbar()) return;
+	this->isReady = true;
+	emit this->ready();
+}
+
+void ToplevelHandle::org_kde_plasma_window_title_changed(const QString& title) {
+	qCDebug(logKdeToplevel) << this << "got title" << title;
+	this->mTitle = title;
+	emit this->titleChanged();
+}
+
+void ToplevelHandle::org_kde_plasma_window_app_id_changed(const QString& appId) {
+	qCDebug(logKdeToplevel) << this << "got app id" << appId;
+	this->mAppId = appId;
+	emit this->appIdChanged();
+}
+
+void ToplevelHandle::org_kde_plasma_window_state_changed(uint32_t flags) {
+	auto changed = flags ^ this->mState;
+	this->mState = flags;
+	qCDebug(logKdeToplevel) << this << "got state" << Qt::hex << flags;
+
+	if ((changed & STATE_ACTIVE) != 0) emit this->activatedChanged();
+	if ((changed & STATE_MAXIMIZED) != 0) emit this->maximizedChanged();
+	if ((changed & STATE_MINIMIZED) != 0) emit this->minimizedChanged();
+	if ((changed & STATE_FULLSCREEN) != 0) emit this->fullscreenChanged();
+
+	this->updateReady();
+}
+
+void ToplevelHandle::org_kde_plasma_window_parent_window(::org_kde_plasma_window* parent) {
+	auto* handle = ToplevelManager::instance()->handleFor(parent);
+	qCDebug(logKdeToplevel) << this << "got parent" << handle;
+
+	if (handle == this->mParent) return;
+
+	if (this->mParent != nullptr) {
+		QObject::disconnect(this->mParent, nullptr, this, nullptr);
+	}
+
+	this->mParent = handle;
+
+	if (handle != nullptr) {
+		QObject::connect(handle, &ToplevelHandle::closed, this, &ToplevelHandle::onParentClosed);
+	}
+
+	emit this->parentChanged();
+}
+
+void ToplevelHandle::onParentClosed() {
+	this->mParent = nullptr;
+	emit this->parentChanged();
+}
+
+void ToplevelHandle::org_kde_plasma_window_geometry(
+    int32_t x,
+    int32_t y,
+    uint32_t width,
+    uint32_t height
+) {
+	this->mGeometry = QRect(x, y, static_cast<int>(width), static_cast<int>(height));
+	this->updateScreens();
+}
+
+void ToplevelHandle::org_kde_plasma_window_initial_state() {
+	qCDebug(logKdeToplevel) << this << "got initial state";
+	this->initialStateReceived = true;
+	this->updateReady();
+}
+
+void ToplevelHandle::org_kde_plasma_window_unmapped() {
+	qCDebug(logKdeToplevel) << this << "unmapped";
+	this->destroy();
+	emit this->closed();
+	delete this;
+}
+
+} // namespace qs::wayland::toplevel::kde
