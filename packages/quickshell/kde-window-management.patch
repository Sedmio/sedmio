@@ -0,0 +1,118 @@
+#pragma once
+
+#include <qlist.h>
+#include <qloggingcategory.h>
+#include <qobject.h>
+#include <qrect.h>
+#include <qscreen.h>
+#include <qstring.h>
+#include <qtmetamacros.h>
+#include <qvector.h>
+#include <qwayland-plasma-window-management.h>
+#include <qwaylandclientextension.h>
+#include <qwindow.h>
+
+#include "../../core/logcat.hpp"
+#include "handle.hpp"
+#include "wayland-plasma-window-management-client-protocol.h"
+
+// Windows of other applications through KWin's own protocol,
+// org_kde_plasma_window_management: KWin does not implement
+// wlr-foreign-toplevel-management. KWin only lets clients bind it when
+// their .desktop file lists it in X-KDE-Wayland-Interfaces
+// (see assets/org.quickshell.desktop).
+namespace qs::wayland::toplevel::kde {
+
+QS_DECLARE_LOGGING_CATEGORY(logKdeToplevel);
+
+class ToplevelHandle
+    : public impl::ToplevelHandle
+    , public QtWayland::org_kde_plasma_window {
+	Q_OBJECT;
+
+public:
+	ToplevelHandle();
+	~ToplevelHandle() override;
+	Q_DISABLE_COPY_MOVE(ToplevelHandle);
+
+	[[nodiscard]] QString appId() const override;
+	[[nodiscard]] QString title() const override;
+	[[nodiscard]] impl::ToplevelHandle* parentToplevel() const override;
+	[[nodiscard]] bool activated() const override;
+	[[nodiscard]] bool maximized() const override;
+	[[nodiscard]] bool minimized() const override;
+	[[nodiscard]] bool fullscreen() const override;
+	[[nodiscard]] QList<QScreen*> screens() const override;
+
+	// Windows KWin does not want on a taskbar: desktop, panels of other
+	// shells, on-screen displays and the like. They are never made ready.
+	[[nodiscard]] bool skipTaskbar() const;
+
+	void activate() override;
+	void close() override;
+	void setMaximized(bool maximized) override;
+	void setMinimized(bool minimized) override;
+	void setFullscreen(bool fullscreen) override;
+	void fullscreenOn(QScreen* screen) override;
+	void setRectangle(QWindow* window, QRect rect) override;
+
+private slots:
+	void onParentClosed();
+	void onRectWindowDestroyed();
+	void updateScreens();
+
+private:
+	void org_kde_plasma_window_title_changed(const QString& title) override;
+	void org_kde_plasma_window_app_id_changed(const QString& appId) override;
+	void org_kde_plasma_window_state_changed(uint32_t flags) override;
+	void org_kde_plasma_window_parent_window(::org_kde_plasma_window* parent) override;
+	void org_kde_plasma_window_geometry(int32_t x, int32_t y, uint32_t width, uint32_t height)
+	    override;
+	void org_kde_plasma_window_initial_state() override;
+	void org_kde_plasma_window_unmapped() override;
+
+	void setState(uint32_t flag, bool on);
+	void updateReady();
+
+	bool initialStateReceived = false;
+	bool isReady = false;
+	QString mAppId;
+	QString mTitle;
+	uint32_t mState = 0;
+	ToplevelHandle* mParent = nullptr;
+	QRect mGeometry;
+	QList<QScreen*> mScreens;
+	QWindow* rectWindow = nullptr;
+};
+
+class ToplevelManager
+    : public QWaylandClientExtensionTemplate<ToplevelManager>
+    , public QtWayland::org_kde_plasma_window_management {
+	Q_OBJECT;
+
+public:
+	[[nodiscard]] bool available() const;
+	[[nodiscard]] const QVector<ToplevelHandle*>& readyToplevels() const;
+	[[nodiscard]] ToplevelHandle* handleFor(::org_kde_plasma_window* window);
+
+	static ToplevelManager* instance();
+
+signals:
+	void toplevelReady(ToplevelHandle* toplevel);
+
+protected:
+	explicit ToplevelManager();
+
+	void org_kde_plasma_window_management_window_with_uuid(uint32_t id, const QString& uuid)
+	    override;
+
+private slots:
+	void onToplevelReady();
+	void onToplevelClosed();
+
+private:
+	QVector<ToplevelHandle*> mToplevels;
+	QVector<ToplevelHandle*> mReadyToplevels;
+};
+
+} // namespace qs::wayland::toplevel::kde
