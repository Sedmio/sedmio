prepare() {
  cd "$pkgname"
  # Список окон (ToplevelManager) под KWin через org_kde_plasma_window_management:
  # общий базовый класс окна, wlr-реализация переведена на него, рядом
  # реализация для KDE. В org.quickshell.desktop — X-KDE-Wayland-Interfaces,
  # без него KWin не даёт клиенту этот протокол.
  patch -Np1 -i ../kde-window-management.patch
  # Модуль Quickshell.Services.Kde: то, что в сеансе Plasma ждут от
  # plasmashell, — служба всплывающих индикаторов org.kde.osdService
  # (громкость, яркость, раскладка), раскладки клавиатуры из KWin,
  # яркость экранов из powerdevil, агент паролей Wi‑Fi для NetworkManager,
  # агент сопряжения Bluetooth для BlueZ и сервер заданий (org.kde.kuiserver,
  # org.kde.JobViewServer) — ход копирования файлов из Dolphin и других
  # программ на KIO. При перезагрузке оболочки на ходу (обновление пакета)
  # службы передаются новому поколению, а не теряются до перезахода.
  patch -Np1 -i ../kde-services.patch
  # История буфера обмена (Quickshell.Wayland ClipboardHistory) через
  # ext-data-control-v1: свой движок вместо klipper — запоминает
  # скопированное, хранит на диске и держит буфер заполненным, когда
  # программа-источник закрылась.
  patch -Np1 -i ../clipboard-history.patch
  # OnlyShowIn/NotShowIn из .desktop-файлов (DesktopEntries): программы
  # «не для KDE» (kdesystemsettings.desktop — «Параметры системы KDE» для
  # чужих сред) не попадают в наш запуск программ.
  patch -Np1 -i ../desktop-show-in.patch
  # jemalloc без прозрачных огромных страниц (malloc_conf = "thp:never"):
  # при THP=always в ядре CachyOS оболочка занимала ~1 ГБ вместо ~450 МБ.
  patch -Np1 -i ../jemalloc-no-thp.patch
  # Агент паролей polkit: PAM начинается только после «Подтвердить» —
  # «Отмена» иначе засчитывалась pam_faillock как неверный пароль (три
  # отмены — вход закрыт на 10 минут). И сообщения, переведённые через
  # gettext-domain (всё от systemd), переводим сами: polkitd после первого
  # запроса оставляет у себя LANGUAGE=C и шлёт их по-английски.
  patch -Np1 -i ../polkit-agent.patch
  # Перезагрузка QML на ходу (обновление пакета): окно, которое надо
  # перенести на другой экран, скрывалось, и это считалось закрытием —
  # окно слоя (панель, рамка, обои) удалялось, а следом шло обращение к
  # нему (падение оболочки), обычное оставалось скрытым. Теперь окно слоя
  # создаётся заново на нужном экране, обычное переезжает.
  patch -Np1 -i ../reload-screen.patch
  # Рабочие столы KWin (org_kde_plasma_virtual_desktop_management) и
  # свойство окна Toplevel.inCurrentDesktop: на панели — только окна
  # текущего стола, как в Windows. Протокол тоже вписан в
  # X-KDE-Wayland-Interfaces.
  patch -Np1 -i ../kde-virtual-desktops.patch
  # Миниатюры окон: WindowStream просит у KWin поток PipeWire с окном
  # (zkde_screencast_unstable_v1, как панель задач Plasma), показывает его
  # PipeWireSourceItem из kpipewire. Протокол вписан в X-KDE-Wayland-Interfaces.
  patch -Np1 -i ../kde-window-thumbnails.patch
  # Трей: SystemTrayItem.contextMenu(x, y) — метод SNI ContextMenu для
  # значков без dbusmenu (старые X11-программы через xembedsniproxy: тот
  # щёлкает правой кнопкой по самому значку), и activate/secondaryActivate
  # с координатами — прокси щёлкает там, и меню программы появляется у трея.
  patch -Np1 -i ../tray-context-menu.patch
}

build() {
  local cmake_options=(
    -D CMAKE_BUILD_TYPE=RelWithDebInfo
    -D DISTRIBUTOR='Sedmio'
    -D DISTRIBUTOR_DEBUGINFO_AVAILABLE=No
    # Без своего обработчика падений: он показывает английское окно
    # «has crashed» и перезапускает Quickshell мимо systemd — тогда не
    # работают счётчик падений и аварийный режим (sedmio-session-manager).
    -D CRASH_HANDLER=OFF
    # Модули Hyprland завязаны на wlr-реализацию окна, а Hyprland нам не нужен.
    -D HYPRLAND=OFF
    -D SCREENCOPY_HYPRLAND_TOPLEVEL=OFF
    -D CMAKE_INSTALL_PREFIX=/usr
    -D INSTALL_QML_PREFIX=lib/qt6/qml
  )
  cmake -G Ninja -S "$pkgname" -B build -W no-dev "${cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$pkgname/LICENSE"
}
