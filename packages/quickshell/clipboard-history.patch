+#pragma once
+
+#include <qbytearray.h>
+#include <qdatetime.h>
+#include <qjsonobject.h>
+#include <qlist.h>
+#include <qmap.h>
+#include <qobject.h>
+#include <qqmlintegration.h>
+#include <qsize.h>
+#include <qstring.h>
+#include <qstringlist.h>
+#include <qtclasshelpermacros.h>
+#include <qtmetamacros.h>
+
+#include "../../core/doc.hpp"
+#include "../../core/model.hpp"
+
+namespace qs::wayland::clipboard {
+
+namespace impl {
+class DataDevice;
+class DataOffer;
+} // namespace impl
+
+///! Something that was copied.
+class ClipboardEntry: public QObject {
+	Q_OBJECT;
+	QML_ELEMENT;
+	QML_UNCREATABLE("ClipboardEntry can only be obtained from ClipboardHistory");
+	/// Stable id of the entry.
+	Q_PROPERTY(QString id READ id CONSTANT);
+	/// `text`, `image` or `files`.
+	Q_PROPERTY(QString kind READ kind CONSTANT);
+	/// The text (shortened for very long texts); for files, their paths.
+	Q_PROPERTY(QString text READ text CONSTANT);
+	/// For `files`: the URLs.
+	Q_PROPERTY(QStringList files READ files CONSTANT);
+	/// For `image`: URL of the image file, usable as an Image source.
+	Q_PROPERTY(QString image READ image CONSTANT);
+	/// For `image`: its size in pixels.
+	Q_PROPERTY(QSize imageSize READ imageSize CONSTANT);
+	/// When it was last copied.
+	Q_PROPERTY(QDateTime time READ time NOTIFY timeChanged);
+	/// Starred entries are kept by @@ClipboardHistory.clear() and do not count
+	/// towards @@ClipboardHistory.maxEntries.
+	Q_PROPERTY(bool starred READ starred WRITE setStarred NOTIFY starredChanged);
+
+public:
+	explicit ClipboardEntry(QObject* parent = nullptr): QObject(parent) {}
+
+	[[nodiscard]] QString id() const { return this->mId; }
+	[[nodiscard]] QString kind() const { return this->mKind; }
+	[[nodiscard]] QString text() const { return this->mText; }
+	[[nodiscard]] QStringList files() const { return this->mFiles; }
+	[[nodiscard]] QString image() const;
+	[[nodiscard]] QSize imageSize() const { return this->mImageSize; }
+	[[nodiscard]] QDateTime time() const { return this->mTime; }
+	[[nodiscard]] bool starred() const { return this->mStarred; }
+	void setStarred(bool starred);
+
+	[[nodiscard]] QJsonObject toJson() const;
+	static ClipboardEntry* fromJson(const QJsonObject& json, QObject* parent);
+
+	QString mId;
+	QString mKind;
+	QString mText;
+	QStringList mFiles;
+	QSize mImageSize;
+	QDateTime mTime;
+	bool mStarred = false;
+	QByteArray mHash;
+	// mime type -> file name in the storage directory
+	QMap<QString, QString> mParts;
+
+signals:
+	void timeChanged();
+	void starredChanged();
+};
+
+/// The clipboard engine: one per process, shared by all ClipboardHistory users.
+class ClipboardEngine: public QObject {
+	Q_OBJECT;
+
+public:
+	static ClipboardEngine* instance();
+
+	[[nodiscard]] bool available() const { return this->device != nullptr; }
+	[[nodiscard]] ObjectModel<ClipboardEntry>* entries() { return &this->mEntries; }
+	[[nodiscard]] QString currentId() const { return this->mCurrentId; }
+	[[nodiscard]] int maxEntries() const { return this->mMaxEntries; }
+	void setMaxEntries(int max);
+
+	void select(const QString& id);
+	void remove(const QString& id);
+	void clear();
+	void save();
+
+signals:
+	void availableChanged();
+	void currentIdChanged();
+	void maxEntriesChanged();
+
+private:
+	explicit ClipboardEngine();
+
+	void setupDevice();
+	void onSelection(impl::DataOffer* offer);
+	void capture(impl::DataOffer* offer, const QStringList& mimeTypes, const QString& kind);
+	void addEntry(const QString& kind, const QMap<QString, QByteArray>& data);
+	void offerEntry(ClipboardEntry* entry);
+	void restore();
+	void trim();
+	void load();
+	void deleteFiles(ClipboardEntry* entry);
+	void setCurrentId(const QString& id);
+	ClipboardEntry* find(const QString& id);
+
+	QString dir;
+	impl::DataDevice* device = nullptr;
+	ObjectModel<ClipboardEntry> mEntries {this};
+	QString mCurrentId;
+	int mMaxEntries = 50;
+	quint64 generation = 0;
+	bool empty = true;
+};
+
+///! History of the clipboard.
+/// Keeps what was copied and puts it back on request. Also keeps the
+/// clipboard filled: when the program something was copied from closes, the
+/// copied data stays available.
+///
+/// History is saved in `$XDG_DATA_HOME/quickshell/clipboard`. Copies marked
+/// as secret by password managers (`x-kde-passwordManagerHint`) are not kept.
+///
+/// > [!NOTE] Requires the compositor to support [ext-data-control-v1].
+///
+/// [ext-data-control-v1]: https://wayland.app/protocols/ext-data-control-v1
+class ClipboardHistory: public QObject {
+	Q_OBJECT;
+	QML_ELEMENT;
+	QML_SINGLETON;
+	/// True if the compositor gives access to the clipboard.
+	Q_PROPERTY(bool available READ available NOTIFY availableChanged);
+	/// Entries, newest first.
+	QSDOC_TYPE_OVERRIDE(ObjectModel<qs::wayland::clipboard::ClipboardEntry>*);
+	Q_PROPERTY(UntypedObjectModel* entries READ entries CONSTANT);
+	/// Id of the entry that is on the clipboard now, or empty.
+	Q_PROPERTY(QString currentId READ currentId NOTIFY currentIdChanged);
+	/// How many entries without a star are kept. Defaults to 50.
+	Q_PROPERTY(int maxEntries READ maxEntries WRITE setMaxEntries NOTIFY maxEntriesChanged);
+
+public:
+	explicit ClipboardHistory(QObject* parent = nullptr);
+
+	[[nodiscard]] static bool available();
+	[[nodiscard]] static UntypedObjectModel* entries();
+	[[nodiscard]] static QString currentId();
+	[[nodiscard]] static int maxEntries();
+	static void setMaxEntries(int max);
+
+	/// Put the entry on the clipboard and move it to the top.
+	Q_INVOKABLE static void select(const QString& id);
+	/// Forget the entry.
+	Q_INVOKABLE static void remove(const QString& id);
+	/// Forget all entries except starred ones.
+	Q_INVOKABLE static void clear();
+
+signals:
+	void availableChanged();
+	void currentIdChanged();
+	void maxEntriesChanged();
+};
+
+} // namespace qs::wayland::clipboard
diff --git a/src/wayland/clipboard/proto.cpp b/src/wayland/clipboard/proto.cpp
new file mode 100644
index 0000000..0de6589
--- /dev/null
+++ b/src/wayland/clipboard/proto.cpp
@@ -0,0 +1,228 @@
+#include "proto.hpp"
+
+#include <cerrno>
+#include <utility>
+
+#include <fcntl.h>
+#include <private/qwaylanddisplay_p.h>
+#include <private/qwaylandintegration_p.h>
+#include <qbytearray.h>
+#include <qlogging.h>
+#include <qloggingcategory.h>
+#include <qobject.h>
+#include <qsocketnotifier.h>
+#include <qwaylandclientextension.h>
+#include <poll.h>
+#include <thread>
+#include <unistd.h>
+#include <wayland-client-core.h>
+
+#include "../../core/logcat.hpp"
+
+namespace qs::wayland::clipboard {
+QS_LOGGING_CATEGORY(logClipboard, "quickshell.wayland.clipboard", QtWarningMsg);
+}
+
+namespace qs::wayland::clipboard::impl {
+
+namespace {
+void flushDisplay() {
+	auto* integration = QtWaylandClient::QWaylandIntegration::instance();
+	if (integration) wl_display_flush(integration->display()->wl_display());
+}
+} // namespace
+
+// ---- Manager
+
+DataControlManager::DataControlManager(): QWaylandClientExtensionTemplate(1) { this->initialize(); }
+
+DataControlManager::~DataControlManager() {
+	if (this->isInitialized()) this->destroy();
+}
+
+DataControlManager* DataControlManager::instance() {
+	static auto* instance = new DataControlManager(); // NOLINT
+	return instance->isInitialized() ? instance : nullptr;
+}
+
+// ---- Offer
+
+DataOffer::~DataOffer() {
+	if (this->isInitialized()) this->destroy();
+}
+
+void DataOffer::ext_data_control_offer_v1_offer(const QString& mimeType) {
+	if (!this->mimeTypes.contains(mimeType)) this->mimeTypes.append(mimeType);
+}
+
+// ---- Source (runs on its own thread)
+
+namespace {
+
+struct SourceState {
+	QMap<QString, QByteArray> data;
+};
+
+// Write everything, giving a reader that stopped reading a few seconds.
+void writeAll(int fd, const QByteArray& data) {
+	qsizetype written = 0;
+	while (written < data.size()) {
+		pollfd pfd {.fd = fd, .events = POLLOUT, .revents = 0};
+		if (poll(&pfd, 1, 3000) <= 0) break;
+		auto count = write(fd, data.constData() + written, data.size() - written);
+		if (count > 0) written += count;
+		else if (count < 0 && (errno == EAGAIN || errno == EINTR)) continue;
+		else break; // the reader went away
+	}
+}
+
+void sourceSend(void* userData, ::ext_data_control_source_v1* /*source*/, const char* mimeType, int32_t fd) {
+	auto* state = static_cast<SourceState*>(userData);
+	const auto it = state->data.constFind(QString::fromUtf8(mimeType));
+	if (it != state->data.cend()) {
+		fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) | O_NONBLOCK);
+		writeAll(fd, it.value());
+	}
+	close(fd);
+}
+
+// Something else is on the clipboard now: this source is done for good.
+void sourceCancelled(void* userData, ::ext_data_control_source_v1* source) {
+	ext_data_control_source_v1_destroy(source);
+	delete static_cast<SourceState*>(userData);
+}
+
+const ext_data_control_source_v1_listener SOURCE_LISTENER = {
+    .send = sourceSend,
+    .cancelled = sourceCancelled,
+};
+
+} // namespace
+
+SourceThread* SourceThread::instance() {
+	static auto* instance = new SourceThread(); // NOLINT
+	return instance;
+}
+
+SourceThread::SourceThread() {
+	this->display = QtWaylandClient::QWaylandIntegration::instance()->display()->wl_display();
+	this->queue = wl_display_create_queue(this->display);
+
+	std::thread([display = this->display, queue = this->queue] {
+		while (wl_display_dispatch_queue(display, queue) != -1) {}
+	}).detach();
+}
+
+void SourceThread::offer(
+    ::ext_data_control_manager_v1* manager,
+    ::ext_data_control_device_v1* device,
+    const QMap<QString, QByteArray>& data
+) {
+	// New objects made through the wrapper land on our queue.
+	auto* wrapper = static_cast<::ext_data_control_manager_v1*>(wl_proxy_create_wrapper(manager));
+	wl_proxy_set_queue(reinterpret_cast<wl_proxy*>(wrapper), this->queue); // NOLINT
+	auto* source = ext_data_control_manager_v1_create_data_source(wrapper);
+	wl_proxy_wrapper_destroy(wrapper);
+
+	auto* state = new SourceState {.data = data};
+	ext_data_control_source_v1_add_listener(source, &SOURCE_LISTENER, state);
+	for (const auto& mimeType: data.keys()) {
+		ext_data_control_source_v1_offer(source, mimeType.toUtf8().constData());
+	}
+
+	ext_data_control_device_v1_set_selection(device, source);
+	wl_display_flush(this->display);
+}
+
+// ---- Device
+
+DataDevice::DataDevice(::ext_data_control_device_v1* device)
+    : QtWayland::ext_data_control_device_v1(device) {}
+
+DataDevice::~DataDevice() {
+	qDeleteAll(this->offers);
+	if (this->isInitialized()) this->destroy();
+}
+
+void DataDevice::ext_data_control_device_v1_data_offer(::ext_data_control_offer_v1* id) {
+	this->offers.insert(id, new DataOffer(id));
+}
+
+void DataDevice::ext_data_control_device_v1_selection(::ext_data_control_offer_v1* id) {
+	DataOffer* offer = id ? this->offers.take(id) : nullptr;
+	emit this->selectionChanged(offer);
+}
+
+void DataDevice::ext_data_control_device_v1_primary_selection(::ext_data_control_offer_v1* id) {
+	// Primary selection (middle click paste) is not kept.
+	if (id) delete this->offers.take(id);
+}
+
+void DataDevice::ext_data_control_device_v1_finished() { emit this->finished(); }
+
+// ---- Reading
+
+PipeReader::PipeReader(DataOffer* offer, const QString& mimeType, qsizetype limit, QObject* parent)
+    : QObject(parent)
+    , mimeType(mimeType)
+    , limit(limit) {
+	int fds[2]; // NOLINT
+	if (pipe2(fds, O_CLOEXEC | O_NONBLOCK) != 0) {
+		QTimer::singleShot(0, this, [this] { this->finish(false); });
+		return;
+	}
+
+	offer->receive(mimeType, fds[1]);
+	close(fds[1]);
+	flushDisplay();
+
+	this->fd = fds[0];
+	this->notifier = new QSocketNotifier(this->fd, QSocketNotifier::Read, this);
+	QObject::connect(this->notifier, &QSocketNotifier::activated, this, &PipeReader::onReadable);
+
+	// A client that never answers must not hold the clipboard history up.
+	this->timeout.setSingleShot(true);
+	this->timeout.setInterval(5000);
+	QObject::connect(&this->timeout, &QTimer::timeout, this, [this] { this->finish(false); });
+	this->timeout.start();
+}
+
+PipeReader::~PipeReader() {
+	if (this->fd != -1) close(this->fd);
+}
+
+void PipeReader::onReadable() {
+	char buffer[65536]; // NOLINT
+	while (true) {
+		auto count = read(this->fd, buffer, sizeof(buffer));
+		if (count > 0) {
+			this->data.append(buffer, count);
+			if (this->data.size() > this->limit) {
+				this->finish(false);
+				return;
+			}
+		} else if (count == 0) {
+			this->finish(true);
+			return;
+		} else {
+			if (errno == EAGAIN || errno == EINTR) return;
+			this->finish(false);
+			return;
+		}
+	}
+}
+
+void PipeReader::finish(bool ok) {
+	if (this->finished) return;
+	this->finished = true;
+	this->timeout.stop();
+	if (this->notifier) this->notifier->setEnabled(false);
+	if (this->fd != -1) {
+		close(this->fd);
+		this->fd = -1;
+	}
+	if (!ok) this->data.clear();
+	emit this->done(ok);
+}
+
+} // namespace qs::wayland::clipboard::impl
