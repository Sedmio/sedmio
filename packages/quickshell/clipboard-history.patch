+#include <wayland-ext-data-control-v1-client-protocol.h>
+
+#include "../../core/logcat.hpp"
+
+namespace qs::wayland::clipboard {
+QS_DECLARE_LOGGING_CATEGORY(logClipboard);
+}
+
+namespace qs::wayland::clipboard::impl {
+
+class DataControlManager
+    : public QWaylandClientExtensionTemplate<DataControlManager>
+    , public QtWayland::ext_data_control_manager_v1 {
+public:
+	explicit DataControlManager();
+	~DataControlManager() override;
+	Q_DISABLE_COPY_MOVE(DataControlManager);
+
+	static DataControlManager* instance();
+};
+
+/// Something on the clipboard, offered by another client.
+class DataOffer: public QtWayland::ext_data_control_offer_v1 {
+public:
+	explicit DataOffer(::ext_data_control_offer_v1* offer)
+	    : QtWayland::ext_data_control_offer_v1(offer) {}
+	~DataOffer() override;
+	Q_DISABLE_COPY_MOVE(DataOffer);
+
+	QStringList mimeTypes;
+
+protected:
+	void ext_data_control_offer_v1_offer(const QString& mimeType) override;
+};
+
+/// Offers data on the clipboard from a separate thread with its own wayland
+/// event queue: a paste must be answered even while the main thread waits
+/// for the clipboard itself (Qt reads it synchronously, e.g. for text fields).
+class SourceThread {
+public:
+	static SourceThread* instance();
+
+	/// Offer the data and make it the selection of the device.
+	void offer(::ext_data_control_manager_v1* manager, ::ext_data_control_device_v1* device, const QMap<QString, QByteArray>& data);
+
+private:
+	SourceThread();
+	::wl_display* display = nullptr;
+	::wl_event_queue* queue = nullptr;
+};
+
+class DataDevice
+    : public QObject
+    , public QtWayland::ext_data_control_device_v1 {
+	Q_OBJECT;
+
+public:
+	explicit DataDevice(::ext_data_control_device_v1* device);
+	~DataDevice() override;
+	Q_DISABLE_COPY_MOVE(DataDevice);
+
+signals:
+	/// The clipboard changed. The receiver owns the offer; null when the clipboard is empty.
+	void selectionChanged(DataOffer* offer);
+	void finished();
+
+protected:
+	void ext_data_control_device_v1_data_offer(::ext_data_control_offer_v1* id) override;
+	void ext_data_control_device_v1_selection(::ext_data_control_offer_v1* id) override;
+	void ext_data_control_device_v1_primary_selection(::ext_data_control_offer_v1* id) override;
+	void ext_data_control_device_v1_finished() override;
+
+private:
+	QHash<::ext_data_control_offer_v1*, DataOffer*> offers;
+};
+
+/// Reads one mime type of an offer through a pipe, without blocking.
+class PipeReader: public QObject {
+	Q_OBJECT;
+
+public:
+	PipeReader(DataOffer* offer, const QString& mimeType, qsizetype limit, QObject* parent);
+	~PipeReader() override;
+	Q_DISABLE_COPY_MOVE(PipeReader);
+
+	QString mimeType;
+	QByteArray data;
+
+signals:
+	/// ok is false on error, timeout or when the data is over the limit.
+	void done(bool ok);
+
+private:
+	void onReadable();
+	void finish(bool ok);
+
+	int fd = -1;
+	qsizetype limit;
+	QSocketNotifier* notifier = nullptr;
+	QTimer timeout;
+	bool finished = false;
+};
+
+} // namespace qs::wayland::clipboard::impl
