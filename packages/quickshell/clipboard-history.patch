+using impl::DataControlManager;
+using impl::DataDevice;
+using impl::DataOffer;
+using impl::PipeReader;
+
+namespace {
+
+// Marks clipboard contents offered by us, so we do not record them again.
+constexpr auto OWN_MIME = "application/x-quickshell-clipboard-history";
+constexpr auto SECRET_MIME = "x-kde-passwordManagerHint";
+constexpr auto TEXT_MIME = "text/plain;charset=utf-8";
+constexpr auto HTML_MIME = "text/html";
+constexpr auto URI_MIME = "text/uri-list";
+constexpr auto GNOME_FILES_MIME = "x-special/gnome-copied-files";
+
+const QStringList TEXT_MIMES = {TEXT_MIME, "UTF8_STRING", "text/plain", "STRING", "TEXT"};
+const QStringList IMAGE_MIMES =
+    {"image/png", "image/jpeg", "image/webp", "image/gif", "image/bmp", "image/tiff"};
+
+constexpr qsizetype TEXT_LIMIT = 4 * 1024 * 1024;
+constexpr qsizetype HTML_LIMIT = 2 * 1024 * 1024;
+constexpr qsizetype IMAGE_LIMIT = 32 * 1024 * 1024;
+constexpr qsizetype URI_LIMIT = 1024 * 1024;
+constexpr qsizetype SHOWN_TEXT = 10000;
+
+QString storageDir() {
+	static const QString dir =
+	    QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + "/quickshell/clipboard";
+	return dir;
+}
+
+QString extensionFor(const QString& mimeType) {
+	if (mimeType == "image/png") return ".png";
+	if (mimeType == "image/jpeg") return ".jpg";
+	if (mimeType == "image/webp") return ".webp";
+	if (mimeType == "image/gif") return ".gif";
+	if (mimeType == "image/bmp") return ".bmp";
+	if (mimeType == "image/tiff") return ".tiff";
+	if (mimeType == HTML_MIME) return ".html";
+	return ".txt";
+}
+
+qsizetype limitFor(const QString& mimeType) {
+	if (mimeType.startsWith("image/")) return IMAGE_LIMIT;
+	if (mimeType == HTML_MIME) return HTML_LIMIT;
+	if (mimeType == URI_MIME || mimeType == GNOME_FILES_MIME) return URI_LIMIT;
+	return TEXT_LIMIT;
+}
+
+QStringList parseUriList(const QByteArray& data) {
+	QStringList uris;
+	for (const auto& line: QString::fromUtf8(data).split('\n')) {
+		const auto uri = line.trimmed();
+		if (!uri.isEmpty() && !uri.startsWith('#')) uris.append(uri);
+	}
+	return uris;
+}
+
+/// Reads all wanted mime types of one offer.
+class CaptureJob: public QObject {
+public:
+	CaptureJob(DataOffer* offer, QObject* parent): QObject(parent), offer(offer) {}
+	~CaptureJob() override { delete this->offer; }
+	Q_DISABLE_COPY_MOVE(CaptureJob);
+
+	DataOffer* offer;
+	QMap<QString, QByteArray> results;
+	int pending = 0;
+};
+
+} // namespace
+
+// ---- Entry
+
+QString ClipboardEntry::image() const {
+	if (this->mKind != "image" || this->mParts.isEmpty()) return QString();
+	return QUrl::fromLocalFile(storageDir() + '/' + this->mParts.first()).toString();
+}
+
+void ClipboardEntry::setStarred(bool starred) {
+	if (starred == this->mStarred) return;
+	this->mStarred = starred;
+	emit this->starredChanged();
+}
+
+QJsonObject ClipboardEntry::toJson() const {
+	QJsonObject parts;
+	for (auto it = this->mParts.cbegin(); it != this->mParts.cend(); ++it) {
+		parts.insert(it.key(), it.value());
+	}
+
+	return QJsonObject {
+	    {"id", this->mId},
+	    {"kind", this->mKind},
+	    {"text", this->mText},
+	    {"files", QJsonArray::fromStringList(this->mFiles)},
+	    {"imageWidth", this->mImageSize.width()},
+	    {"imageHeight", this->mImageSize.height()},
+	    {"time", this->mTime.toString(Qt::ISODateWithMs)},
+	    {"starred", this->mStarred},
+	    {"hash", QString::fromLatin1(this->mHash.toHex())},
+	    {"parts", parts},
+	};
+}
+
+ClipboardEntry* ClipboardEntry::fromJson(const QJsonObject& json, QObject* parent) {
+	auto* entry = new ClipboardEntry(parent);
+	entry->mId = json.value("id").toString();
+	entry->mKind = json.value("kind").toString();
+	entry->mText = json.value("text").toString();
+	for (const auto& file: json.value("files").toArray()) entry->mFiles.append(file.toString());
+	entry->mImageSize = QSize(json.value("imageWidth").toInt(), json.value("imageHeight").toInt());
+	entry->mTime = QDateTime::fromString(json.value("time").toString(), Qt::ISODateWithMs);
+	entry->mStarred = json.value("starred").toBool();
+	entry->mHash = QByteArray::fromHex(json.value("hash").toString().toLatin1());
+
+	const auto parts = json.value("parts").toObject();
+	for (auto it = parts.constBegin(); it != parts.constEnd(); ++it) {
+		entry->mParts.insert(it.key(), it.value().toString());
+	}
+
+	return entry;
+}
+
+// ---- Engine
+
+ClipboardEngine* ClipboardEngine::instance() {
+	static auto* instance = new ClipboardEngine(); // NOLINT
+	return instance;
+}
+
+ClipboardEngine::ClipboardEngine() {
+	// Writing to a client that stopped reading a paste must not kill the shell.
+	signal(SIGPIPE, SIG_IGN); // NOLINT
+
+	this->dir = storageDir();
+	QDir().mkpath(this->dir);
+	QFile::setPermissions(this->dir, QFile::ReadOwner | QFile::WriteOwner | QFile::ExeOwner);
+
+	this->load();
+	this->setupDevice();
+}
+
+void ClipboardEngine::setupDevice() {
+	auto* manager = DataControlManager::instance();
+	if (manager == nullptr) {
+		qCWarning(logClipboard) << "The compositor does not support ext-data-control-v1;"
+		                           " clipboard history is not available.";
+		return;
+	}
+
+	auto* display = QtWaylandClient::QWaylandIntegration::instance()->display();
+	auto* seat = display->defaultInputDevice();
+	if (seat == nullptr) {
+		// Seats come with the first roundtrips; try again a little later.
+		QTimer::singleShot(500, this, &ClipboardEngine::setupDevice);
+		return;
+	}
+
+	this->device = new DataDevice(manager->get_data_device(seat->object()));
+	this->device->setParent(this);
+
+	QObject::connect(this->device, &DataDevice::selectionChanged, this, &ClipboardEngine::onSelection);
+	QObject::connect(this->device, &DataDevice::finished, this, [this] {
+		this->device->deleteLater();
+		this->device = nullptr;
+		emit this->availableChanged();
+	});
+
+	emit this->availableChanged();
+}
+
+void ClipboardEngine::onSelection(DataOffer* offer) {
+	this->generation++;
+
+	if (offer == nullptr) {
+		// The program the data came from closed (or the clipboard was
+		// cleared): put the last copied thing back.
+		this->empty = true;
+		this->setCurrentId(QString());
+		const auto generation = this->generation;
+		QTimer::singleShot(300, this, [this, generation] {
+			if (generation == this->generation) this->restore();
+		});
+		return;
+	}
+
+	this->empty = false;
+	const auto& mimes = offer->mimeTypes;
+
+	if (mimes.contains(OWN_MIME)) {
+		delete offer;
+		return;
+	}
+
+	if (mimes.contains(SECRET_MIME)) {
+		this->setCurrentId(QString());
+		delete offer;
+		return;
+	}
+
+	QString textMime;
+	for (const auto& mime: TEXT_MIMES) {
+		if (mimes.contains(mime)) {
+			textMime = mime;
+			break;
+		}
+	}
+
+	QString imageMime;
+	for (const auto& mime: IMAGE_MIMES) {
+		if (mimes.contains(mime)) {
+			imageMime = mime;
+			break;
+		}
+	}
+
+	if (mimes.contains(URI_MIME)) {
+		QStringList wanted = {URI_MIME};
+		if (mimes.contains(GNOME_FILES_MIME)) wanted.append(GNOME_FILES_MIME);
+		if (!textMime.isEmpty()) wanted.append(textMime);
+		this->capture(offer, wanted, "files");
+	} else if (!textMime.isEmpty()) {
+		QStringList wanted = {textMime};
+		if (mimes.contains(HTML_MIME)) wanted.append(HTML_MIME);
+		this->capture(offer, wanted, "text");
+	} else if (!imageMime.isEmpty()) {
+		this->capture(offer, {imageMime}, "image");
+	} else {
+		this->setCurrentId(QString());
+		delete offer;
+	}
+}
+
+void ClipboardEngine::capture(DataOffer* offer, const QStringList& mimeTypes, const QString& kind) {
+	auto* job = new CaptureJob(offer, this);
+	job->pending = static_cast<int>(mimeTypes.size());
+	const auto generation = this->generation;
+
+	for (const auto& mime: mimeTypes) {
+		auto* reader = new PipeReader(offer, mime, limitFor(mime), job);
+		QObject::connect(reader, &PipeReader::done, job, [this, job, reader, kind, generation](bool ok) {
+			if (ok) job->results.insert(reader->mimeType, reader->data);
+			if (--job->pending > 0) return;
+
+			// Something newer was copied meanwhile.
+			if (generation == this->generation) this->addEntry(kind, job->results);
+			job->deleteLater();
+		});
+	}
+}
+
+void ClipboardEngine::addEntry(const QString& requestedKind, const QMap<QString, QByteArray>& data) {
+	auto kind = requestedKind;
+
+	QByteArray textData;
+	for (const auto& mime: TEXT_MIMES) {
+		if (data.contains(mime)) {
+			textData = data.value(mime);
+			break;
+		}
+	}
+
+	QStringList files;
+	if (kind == "files") {
+		files = parseUriList(data.value(URI_MIME));
+		const bool local =
+		    !files.isEmpty() && std::ranges::all_of(files, [](const QString& uri) { return uri.startsWith("file:"); });
+		if (!local) {
+			// Links rather than files: keep as text.
+			kind = "text";
+			if (textData.isEmpty()) textData = files.join('\n').toUtf8();
+		}
+	}
+
+	auto* entry = new ClipboardEntry(this);
+	entry->mKind = kind;
+	QMap<QString, QByteArray> parts;
+
+	if (kind == "text") {
+		const auto text = QString::fromUtf8(textData);
+		if (text.trimmed().isEmpty()) {
+			delete entry;
+			this->setCurrentId(QString());
+			return;
+		}
+		entry->mText = text.left(SHOWN_TEXT);
+		parts.insert(TEXT_MIME, textData);
+		if (data.contains(HTML_MIME) && !data.value(HTML_MIME).isEmpty()) {
+			parts.insert(HTML_MIME, data.value(HTML_MIME));
+		}
+		entry->mHash = QCryptographicHash::hash(textData, QCryptographicHash::Sha1);
+	} else if (kind == "files") {
+		entry->mFiles = files;
+		QStringList paths;
+		for (const auto& uri: files) paths.append(QUrl(uri).toLocalFile());
+		entry->mText = paths.join('\n');
+		parts.insert(URI_MIME, data.value(URI_MIME));
+		if (data.contains(GNOME_FILES_MIME)) parts.insert(GNOME_FILES_MIME, data.value(GNOME_FILES_MIME));
+		entry->mHash = QCryptographicHash::hash(data.value(URI_MIME), QCryptographicHash::Sha1);
+	} else {
+		const auto mime = data.firstKey();
+		const auto bytes = data.value(mime);
+		QBuffer buffer;
+		buffer.setData(bytes);
+		QImageReader reader(&buffer);
+		entry->mImageSize = reader.size();
+		if (bytes.isEmpty() || !entry->mImageSize.isValid()) {
+			delete entry;
+			this->setCurrentId(QString());
+			return;
+		}
+		parts.insert(mime, bytes);
+		entry->mHash = QCryptographicHash::hash(bytes, QCryptographicHash::Sha1);
+	}
+
+	entry->mHash.prepend(kind.toUtf8());
+	entry->mTime = QDateTime::currentDateTime();
+
+	// The same thing copied again: move it up instead of adding a copy.
+	for (auto* existing: this->mEntries.valueList()) {
+		if (existing->mHash != entry->mHash) continue;
+		delete entry;
+		this->mEntries.removeObject(existing);
+		this->mEntries.insertObject(existing, 0);
+		existing->mTime = QDateTime::currentDateTime();
+		emit existing->timeChanged();
+		this->setCurrentId(existing->mId);
+		this->save();
+		return;
+	}
+
+	entry->mId = QUuid::createUuid().toString(QUuid::WithoutBraces);
+	int index = 0;
+	for (auto it = parts.cbegin(); it != parts.cend(); ++it, ++index) {
+		const auto name = entry->mId + '-' + QString::number(index) + extensionFor(it.key());
+		QSaveFile file(this->dir + '/' + name);
+		if (!file.open(QIODevice::WriteOnly) || file.write(it.value()) != it.value().size()
+		    || !file.commit())
+		{
+			qCWarning(logClipboard) << "Could not save a clipboard entry to" << this->dir;
+			entry->mParts.insert(it.key(), name);
+			this->deleteFiles(entry);
+			delete entry;
+			return;
+		}
+		entry->mParts.insert(it.key(), name);
+	}
+
+	QObject::connect(entry, &ClipboardEntry::starredChanged, this, &ClipboardEngine::save);
+	this->mEntries.insertObject(entry, 0);
+	this->setCurrentId(entry->mId);
+	this->trim();
+	this->save();
+}
+
+void ClipboardEngine::offerEntry(ClipboardEntry* entry) {
+	auto* manager = DataControlManager::instance();
+	if (!manager || !this->device) return;
+
+	QMap<QString, QByteArray> stored;
+	for (auto it = entry->mParts.cbegin(); it != entry->mParts.cend(); ++it) {
+		QFile file(this->dir + '/' + it.value());
+		if (!file.open(QIODevice::ReadOnly)) {
+			qCWarning(logClipboard) << "Clipboard entry file is missing:" << file.fileName();
+			return;
+		}
+		stored.insert(it.key(), file.readAll());
+	}
+
+	QMap<QString, QByteArray> offered;
+	if (entry->mKind == "text") {
+		const auto text = stored.value(TEXT_MIME);
+		for (const auto& mime: TEXT_MIMES) offered.insert(mime, text);
+		if (stored.contains(HTML_MIME)) offered.insert(HTML_MIME, stored.value(HTML_MIME));
+	} else if (entry->mKind == "files") {
+		offered.insert(URI_MIME, stored.value(URI_MIME));
+		offered.insert(
+		    GNOME_FILES_MIME,
+		    stored.value(GNOME_FILES_MIME, "copy\n" + entry->mFiles.join('\n').toUtf8())
+		);
+		const auto paths = entry->mText.toUtf8();
+		offered.insert(TEXT_MIME, paths);
+		offered.insert("text/plain", paths);
+	} else {
+		offered = stored;
+	}
+	offered.insert(OWN_MIME, "1");
+
+	impl::SourceThread::instance()->offer(manager->object(), this->device->object(), offered);
+	this->empty = false;
+	this->setCurrentId(entry->mId);
+}
+
+void ClipboardEngine::restore() {
+	if (!this->empty || this->mEntries.valueList().isEmpty()) return;
+	this->offerEntry(this->mEntries.valueList().constFirst());
+}
+
+void ClipboardEngine::select(const QString& id) {
+	auto* entry = this->find(id);
+	if (!entry) return;
+
+	if (this->mEntries.valueList().indexOf(entry) != 0) {
+		this->mEntries.removeObject(entry);
+		this->mEntries.insertObject(entry, 0);
+	}
+	entry->mTime = QDateTime::currentDateTime();
+	emit entry->timeChanged();
+
+	this->offerEntry(entry);
+	this->save();
+}
+
+void ClipboardEngine::remove(const QString& id) {
+	auto* entry = this->find(id);
+	if (!entry) return;
+
+	if (this->mCurrentId == id) this->setCurrentId(QString());
+	this->mEntries.removeObject(entry);
+	this->deleteFiles(entry);
+	entry->deleteLater();
+	this->save();
+}
+
+void ClipboardEngine::clear() {
+	const auto entries = this->mEntries.valueList();
+	for (auto* entry: entries) {
+		if (entry->mStarred) continue;
+		if (this->mCurrentId == entry->mId) this->setCurrentId(QString());
+		this->mEntries.removeObject(entry);
+		this->deleteFiles(entry);
+		entry->deleteLater();
+	}
+	this->save();
+}
+
+void ClipboardEngine::trim() {
+	int unstarred = 0;
+	const auto entries = this->mEntries.valueList();
+	for (auto* entry: entries) {
+		if (entry->mStarred) continue;
+		if (++unstarred <= this->mMaxEntries) continue;
+		this->mEntries.removeObject(entry);
+		this->deleteFiles(entry);
+		entry->deleteLater();
+	}
+}
+
+void ClipboardEngine::setMaxEntries(int max) {
+	max = std::max(1, max);
+	if (max == this->mMaxEntries) return;
+	this->mMaxEntries = max;
+	emit this->maxEntriesChanged();
+	this->trim();
+	this->save();
+}
+
+void ClipboardEngine::deleteFiles(ClipboardEntry* entry) {
+	for (const auto& name: entry->mParts) QFile::remove(this->dir + '/' + name);
+}
+
+ClipboardEntry* ClipboardEngine::find(const QString& id) {
+	for (auto* entry: this->mEntries.valueList()) {
+		if (entry->mId == id) return entry;
+	}
+	return nullptr;
+}
+
+void ClipboardEngine::setCurrentId(const QString& id) {
+	if (id == this->mCurrentId) return;
+	this->mCurrentId = id;
+	emit this->currentIdChanged();
+}
+
+void ClipboardEngine::save() {
+	QJsonArray entries;
+	for (auto* entry: this->mEntries.valueList()) entries.append(entry->toJson());
+
+	QSaveFile file(this->dir + "/history.json");
+	if (!file.open(QIODevice::WriteOnly)) {
+		qCWarning(logClipboard) << "Could not save clipboard history to" << file.fileName();
+		return;
+	}
+	file.write(QJsonDocument(QJsonObject {{"version", 1}, {"entries", entries}}).toJson(QJsonDocument::Compact));
+	file.commit();
+}
+
+void ClipboardEngine::load() {
+	QFile file(this->dir + "/history.json");
+	if (!file.open(QIODevice::ReadOnly)) return;
+
+	const auto json = QJsonDocument::fromJson(file.readAll()).object();
+	QSet<QString> known;
+	for (const auto& value: json.value("entries").toArray()) {
+		auto* entry = ClipboardEntry::fromJson(value.toObject(), this);
+		const bool complete = !entry->mId.isEmpty() && !entry->mParts.isEmpty()
+		                   && std::ranges::all_of(entry->mParts, [this](const QString& name) {
+			                      return QFile::exists(this->dir + '/' + name);
+		                      });
+		if (!complete) {
+			delete entry;
+			continue;
+		}
+		for (const auto& name: entry->mParts) known.insert(name);
+		QObject::connect(entry, &ClipboardEntry::starredChanged, this, &ClipboardEngine::save);
+		this->mEntries.insertObject(entry);
+	}
+
+	// Files of entries that are gone (e.g. after a crash).
+	for (const auto& name: QDir(this->dir).entryList(QDir::Files)) {
+		if (name != "history.json" && !known.contains(name)) QFile::remove(this->dir + '/' + name);
+	}
+}
+
+// ---- QML
+
+ClipboardHistory::ClipboardHistory(QObject* parent): QObject(parent) {
+	auto* engine = ClipboardEngine::instance();
+	QObject::connect(engine, &ClipboardEngine::availableChanged, this, &ClipboardHistory::availableChanged);
+	QObject::connect(engine, &ClipboardEngine::currentIdChanged, this, &ClipboardHistory::currentIdChanged);
+	QObject::connect(engine, &ClipboardEngine::maxEntriesChanged, this, &ClipboardHistory::maxEntriesChanged);
+}
+
+bool ClipboardHistory::available() { return ClipboardEngine::instance()->available(); }
+UntypedObjectModel* ClipboardHistory::entries() { return ClipboardEngine::instance()->entries(); }
+QString ClipboardHistory::currentId() { return ClipboardEngine::instance()->currentId(); }
+int ClipboardHistory::maxEntries() { return ClipboardEngine::instance()->maxEntries(); }
+void ClipboardHistory::setMaxEntries(int max) { ClipboardEngine::instance()->setMaxEntries(max); }
+void ClipboardHistory::select(const QString& id) { ClipboardEngine::instance()->select(id); }
+void ClipboardHistory::remove(const QString& id) { ClipboardEngine::instance()->remove(id); }
+void ClipboardHistory::clear() { ClipboardEngine::instance()->clear(); }
+
+} // namespace qs::wayland::clipboard
