+++ b/src/services/kde/keyboard.cpp
@@ -0,0 +1,142 @@
+#include "keyboard.hpp"
+
+#include <qdbusargument.h>
+#include <qdbusconnection.h>
+#include <qdbusmessage.h>
+#include <qdbuspendingcall.h>
+#include <qdbuspendingreply.h>
+#include <qdbusservicewatcher.h>
+#include <qlogging.h>
+#include <qloggingcategory.h>
+#include <qobject.h>
+#include <qstring.h>
+#include <qvariant.h>
+
+#include "../../core/logcat.hpp"
+
+namespace qs::service::kde {
+
+namespace {
+QS_LOGGING_CATEGORY(logKeyboard, "quickshell.service.kde.keyboard", QtWarningMsg);
+
+constexpr auto SERVICE = "org.kde.keyboard";
+constexpr auto PATH = "/Layouts";
+constexpr auto INTERFACE = "org.kde.KeyboardLayouts";
+} // namespace
+
+KeyboardLayouts::KeyboardLayouts(QObject* parent): QObject(parent) {
+	auto bus = QDBusConnection::sessionBus();
+
+	bus.connect(SERVICE, PATH, INTERFACE, "layoutChanged", this, SLOT(onLayoutChanged(uint)));
+	bus.connect(SERVICE, PATH, INTERFACE, "layoutListChanged", this, SLOT(onLayoutListChanged()));
+
+	// KWin owns the service and normally is there before the shell, but
+	// pick it up if it (re)appears later.
+	auto* watcher = new QDBusServiceWatcher(
+	    SERVICE,
+	    bus,
+	    QDBusServiceWatcher::WatchForRegistration,
+	    this
+	);
+
+	QObject::connect(
+	    watcher,
+	    &QDBusServiceWatcher::serviceRegistered,
+	    this,
+	    &KeyboardLayouts::onLayoutListChanged
+	);
+
+	this->fetchLayouts();
+}
+
+QVariantMap KeyboardLayouts::current() const {
+	if (this->mCurrentIndex < 0 || this->mCurrentIndex >= this->mLayouts.size()) return {};
+	return this->mLayouts.at(this->mCurrentIndex).toMap();
+}
+
+void KeyboardLayouts::switchToNext() { this->call("switchToNextLayout"); }
+void KeyboardLayouts::switchToPrevious() { this->call("switchToPreviousLayout"); }
+
+void KeyboardLayouts::setLayout(int index) {
+	if (index < 0) return;
+	this->call("setLayout", {QVariant::fromValue(static_cast<uint>(index))});
+}
+
+void KeyboardLayouts::call(const QString& method, const QVariantList& args) {
+	auto message = QDBusMessage::createMethodCall(SERVICE, PATH, INTERFACE, method);
+	message.setArguments(args);
+	QDBusConnection::sessionBus().asyncCall(message);
+}
+
+void KeyboardLayouts::onLayoutChanged(uint index) {
+	this->setCurrentIndex(static_cast<int>(index));
+}
+
+void KeyboardLayouts::onLayoutListChanged() { this->fetchLayouts(); }
+
+void KeyboardLayouts::fetchLayouts() {
+	auto message = QDBusMessage::createMethodCall(SERVICE, PATH, INTERFACE, "getLayoutsList");
+	auto* watcher =
+	    new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message), this);
+
+	QObject::connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher* call) {
+		call->deleteLater();
+		const QDBusMessage reply = call->reply();
+
+		if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+			qCWarning(logKeyboard) << "Could not read keyboard layouts:" << reply.errorMessage();
+			return;
+		}
+
+		// a(sss): shortName, displayName, longName
+		QVariantList layouts;
+		const auto arg = reply.arguments().constFirst().value<QDBusArgument>();
+		arg.beginArray();
+		while (!arg.atEnd()) {
+			QString shortName;
+			QString displayName;
+			QString longName;
+			arg.beginStructure();
+			arg >> shortName >> displayName >> longName;
+			arg.endStructure();
+			layouts.push_back(QVariantMap {
+			    {"shortName", shortName},
+			    {"displayName", displayName},
+			    {"longName", longName},
+			});
+		}
+		arg.endArray();
+
+		this->mLayouts = layouts;
+		emit this->layoutsChanged();
+		emit this->currentChanged();
+		this->fetchCurrent();
+	});
+}
+
+void KeyboardLayouts::fetchCurrent() {
+	auto message = QDBusMessage::createMethodCall(SERVICE, PATH, INTERFACE, "getLayout");
+	auto* watcher =
+	    new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message), this);
+
+	QObject::connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher* call) {
+		call->deleteLater();
+		const QDBusPendingReply<uint> reply = *call;
+
+		if (reply.isError()) {
+			qCWarning(logKeyboard) << "Could not read the current keyboard layout:" << reply.error().message();
+			return;
+		}
+
+		this->setCurrentIndex(static_cast<int>(reply.value()));
+	});
+}
+
+void KeyboardLayouts::setCurrentIndex(int index) {
+	if (index == this->mCurrentIndex) return;
+	this->mCurrentIndex = index;
+	emit this->currentIndexChanged();
+	emit this->currentChanged();
+}
+
+} // namespace qs::service::kde
diff --git a/src/services/kde/keyboard.hpp b/src/services/kde/keyboard.hpp
new file mode 100644
index 0000000..d3f0dba
--- /dev/null
+++ b/src/services/kde/keyboard.hpp
@@ -0,0 +1,58 @@
+#pragma once
+
+#include <qobject.h>
+#include <qqmlintegration.h>
+#include <qstring.h>
+#include <qtmetamacros.h>
+#include <qvariant.h>
+
+namespace qs::service::kde {
+
+///! Keyboard layouts of KWin.
+/// Reads and switches layouts through KWin's org.kde.keyboard service
+/// (/Layouts, org.kde.KeyboardLayouts) — the same one Plasma's layout
+/// indicator uses. Layouts themselves are set up in System Settings.
+class KeyboardLayouts: public QObject {
+	Q_OBJECT;
+	QML_ELEMENT;
+	QML_SINGLETON;
+	/// Configured layouts, in order. Each is an object with
+	/// `shortName` (`us`), `displayName` (short label set by the user,
+	/// often empty) and `longName` (`English (US)`).
+	Q_PROPERTY(QVariantList layouts READ layouts NOTIFY layoutsChanged);
+	/// Index of the active layout in @@layouts, -1 until known.
+	Q_PROPERTY(int currentIndex READ currentIndex NOTIFY currentIndexChanged);
+	/// The active layout (see @@layouts), or an empty object.
+	Q_PROPERTY(QVariantMap current READ current NOTIFY currentChanged);
+
+public:
+	explicit KeyboardLayouts(QObject* parent = nullptr);
+
+	[[nodiscard]] QVariantList layouts() const { return this->mLayouts; }
+	[[nodiscard]] int currentIndex() const { return this->mCurrentIndex; }
+	[[nodiscard]] QVariantMap current() const;
+
+	Q_INVOKABLE void switchToNext();
+	Q_INVOKABLE void switchToPrevious();
+	Q_INVOKABLE void setLayout(int index);
+
+signals:
+	void layoutsChanged();
+	void currentIndexChanged();
+	void currentChanged();
+
+private slots:
+	void onLayoutChanged(uint index);
+	void onLayoutListChanged();
+
+private:
+	void fetchLayouts();
+	void fetchCurrent();
+	void setCurrentIndex(int index);
+	void call(const QString& method, const QVariantList& args = {});
+
+	QVariantList mLayouts;
+	int mCurrentIndex = -1;
+};
+
+} // namespace qs::service::kde
