+#include "osd.hpp"
+
+#include <qdbusconnection.h>
+#include <qlogging.h>
+#include <qloggingcategory.h>
+#include <qobject.h>
+#include <qrect.h>
+#include <qstring.h>
+
+#include "../../core/logcat.hpp"
+
+namespace qs::service::kde {
+
+namespace {
+QS_LOGGING_CATEGORY(logOsd, "quickshell.service.kde.osd", QtWarningMsg);
+
+constexpr auto SERVICE = "org.kde.plasmashell";
+constexpr auto PATH = "/org/kde/osdService";
+} // namespace
+
+OsdAdaptor::OsdAdaptor(OsdServer* server): server(server) {}
+
+void OsdAdaptor::brightnessChanged(int percent) {
+	emit this->server->progress("brightness", QString(), percent, 100, QString());
+}
+
+void OsdAdaptor::screenBrightnessChanged(
+    int percent,
+    const QString& /*displayId*/,
+    const QString& displayLabel,
+    int /*priority*/,
+    const QRect& /*screenRect*/
+) {
+	emit this->server->progress("brightness", QString(), percent, 100, displayLabel);
+}
+
+void OsdAdaptor::keyboardBrightnessChanged(int percent) {
+	emit this->server->progress("keyboardBrightness", QString(), percent, 100, QString());
+}
+
+void OsdAdaptor::volumeChanged(int percent) { this->volumeChanged(percent, 100); }
+
+void OsdAdaptor::volumeChanged(int percent, int maximumPercent) {
+	emit this->server->progress("volume", QString(), percent, maximumPercent, QString());
+}
+
+void OsdAdaptor::microphoneVolumeChanged(int percent) {
+	emit this->server->progress("microphone", QString(), percent, 100, QString());
+}
+
+void OsdAdaptor::mediaPlayerVolumeChanged(
+    int percent,
+    const QString& playerName,
+    const QString& playerIconName
+) {
+	emit this->server->progress("mediaPlayer", playerIconName, percent, 100, playerName);
+}
+
+void OsdAdaptor::kbdLayoutChanged(const QString& layoutName) {
+	emit this->server->message("layout", "keyboard-layout", layoutName);
+}
+
+void OsdAdaptor::virtualDesktopChanged(const QString& currentVirtualDesktopName) {
+	emit this->server->message("desktop", QString(), currentVirtualDesktopName);
+}
+
+void OsdAdaptor::touchpadEnabledChanged(bool touchpadEnabled) {
+	emit this->server->toggled("touchpad", touchpadEnabled);
+}
+
+void OsdAdaptor::wifiEnabledChanged(bool wifiEnabled) {
+	emit this->server->toggled("wifi", wifiEnabled);
+}
+
+void OsdAdaptor::bluetoothEnabledChanged(bool bluetoothEnabled) {
+	emit this->server->toggled("bluetooth", bluetoothEnabled);
+}
+
+void OsdAdaptor::wwanEnabledChanged(bool wwanEnabled) {
+	emit this->server->toggled("wwan", wwanEnabled);
+}
+
+void OsdAdaptor::virtualKeyboardEnabledChanged(bool virtualKeyboardEnabled) {
+	emit this->server->toggled("virtualKeyboard", virtualKeyboardEnabled);
+}
+
+void OsdAdaptor::powerManagementInhibitedChanged(bool inhibited) {
+	emit this->server->toggled("inhibited", inhibited);
+}
+
+void OsdAdaptor::powerProfileChanged(const QString& profile) {
+	emit this->server->message("powerProfile", QString(), profile);
+}
+
+void OsdAdaptor::showText(const QString& icon, const QString& text) {
+	emit this->server->message("text", icon, text);
+}
+
+void OsdAdaptor::hide() { emit this->server->hideRequested(); }
+
+OsdServer::OsdServer(QObject* parent): QObject(parent) {
+	auto bus = QDBusConnection::sessionBus();
+
+	if (!bus.isConnected()) {
+		qCWarning(logOsd) << "Could not connect to the session bus, OSD service unavailable.";
+		return;
+	}
+
+	if (!bus.registerObject(PATH, &this->adaptor, QDBusConnection::ExportAllSlots)) {
+		qCWarning(logOsd) << "Could not register" << PATH << "- another OsdServer exists?";
+		return;
+	}
+
+	if (!bus.registerService(SERVICE)) {
+		qCWarning(logOsd) << "Could not register" << SERVICE << "- is plasmashell running?";
+		bus.unregisterObject(PATH);
+		return;
+	}
+
+	qCInfo(logOsd) << "OSD service registered as" << SERVICE;
+	this->mActive = true;
+}
+
+OsdServer::~OsdServer() {
+	if (!this->mActive) return;
+
+	auto bus = QDBusConnection::sessionBus();
+	bus.unregisterObject(PATH);
+	bus.unregisterService(SERVICE);
+}
+
+} // namespace qs::service::kde
