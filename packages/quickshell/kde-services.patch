--- /dev/null
+++ b/src/services/kde/bluetoothagent.hpp
@@ -0,0 +1,128 @@
+#pragma once
+
+#include <qdbusconnection.h>
+#include <qdbusmessage.h>
+#include <qdbusvirtualobject.h>
+#include <qlist.h>
+#include <qobject.h>
+#include <qqmlintegration.h>
+#include <qstring.h>
+#include <qtmetamacros.h>
+
+namespace qs::service::kde {
+
+class BluetoothAgent;
+
+/// D-Bus side of the agent: org.bluez.Agent1 on the system bus.
+class BluetoothAgentObject: public QDBusVirtualObject {
+	Q_OBJECT;
+
+public:
+	explicit BluetoothAgentObject(BluetoothAgent* agent);
+
+	QString introspect(const QString& path) const override;
+	bool handleMessage(const QDBusMessage& message, const QDBusConnection& connection) override;
+
+private:
+	BluetoothAgent* agent;
+};
+
+///! Bluetooth pairing prompts (BlueZ agent).
+/// When a device is being paired, BlueZ asks the agent to show or confirm
+/// a code, or to ask for one. In Plasma that is bluedevil in kded; this
+/// lets the shell show its own prompt. Requests are handled one at a time.
+///
+/// Pairing started by the shell itself (`BluetoothDevice.pair()`) always
+/// comes here. Pairing started by the other device, and connections of
+/// devices that are not trusted, go to the default agent: the agent asks to
+/// be it, and asks again a little later, since bluedevil asks the same when
+/// the session starts.
+///
+/// Request kinds:
+/// - `confirm`: does @@code match the one on the device? @@accept() or @@reject().
+/// - `passkey`, `pin`: type the code shown on the device: @@accept(code).
+/// - `display-passkey`, `display-pin`: type @@code on the device (a keyboard);
+///   @@entered keys are typed so far. Nothing to answer: @@accept() hides it.
+/// - `authorize`: the device asks to pair without a code.
+/// - `service`: an untrusted device wants to use a service (@@service is its UUID).
+class BluetoothAgent: public QObject {
+	Q_OBJECT;
+	QML_ELEMENT;
+	/// True while the agent is registered with BlueZ.
+	Q_PROPERTY(bool registered READ registered NOTIFY registeredChanged);
+	/// True while there is a request.
+	Q_PROPERTY(bool active READ active NOTIFY requestChanged);
+	/// See the class docs.
+	Q_PROPERTY(QString kind READ kind NOTIFY requestChanged);
+	/// D-Bus path of the device, as `BluetoothDevice.dbusPath`.
+	Q_PROPERTY(QString devicePath READ devicePath NOTIFY requestChanged);
+	/// Name of the device.
+	Q_PROPERTY(QString deviceName READ deviceName NOTIFY requestChanged);
+	/// Icon name of the device (`phone`, `audio-headphones`...).
+	Q_PROPERTY(QString deviceIcon READ deviceIcon NOTIFY requestChanged);
+	/// Code to compare or to type on the device (passkeys are six digits).
+	Q_PROPERTY(QString code READ code NOTIFY requestChanged);
+	/// For `display-passkey`: how many digits are typed on the device.
+	Q_PROPERTY(int entered READ entered NOTIFY requestChanged);
+	/// For `service`: the service UUID.
+	Q_PROPERTY(QString service READ service NOTIFY requestChanged);
+
+public:
+	explicit BluetoothAgent(QObject* parent = nullptr);
+	~BluetoothAgent() override;
+	Q_DISABLE_COPY_MOVE(BluetoothAgent);
+
+	[[nodiscard]] bool registered() const { return this->mRegistered; }
+	[[nodiscard]] bool active() const { return !this->mQueue.isEmpty(); }
+	[[nodiscard]] QString kind() const;
+	[[nodiscard]] QString devicePath() const;
+	[[nodiscard]] QString deviceName() const;
+	[[nodiscard]] QString deviceIcon() const;
+	[[nodiscard]] QString code() const;
+	[[nodiscard]] int entered() const;
+	[[nodiscard]] QString service() const;
+
+	/// Accept the current request; for `passkey` and `pin`, with the typed code.
+	Q_INVOKABLE void accept(const QString& value = QString());
+	/// Decline the current request (pairing fails).
+	Q_INVOKABLE void reject();
+
+	struct Request {
+		QDBusMessage message; // empty for display requests: nothing to answer
+		QString kind;
+		QString devicePath;
+		QString deviceName;
+		QString deviceIcon;
+		QString code;
+		QString service;
+		int entered = 0;
+	};
+
+	// From BluetoothAgentObject.
+	void handleRequest(const QDBusMessage& message);
+	void release();
+	void cancelRequest();
+
+signals:
+	void registeredChanged();
+	void requestChanged();
+
+private slots:
+	void registerAgent();
+	void onBluezGone();
+	void requestDefault();
+
+private:
+	void enqueue(Request request, bool trusted);
+	void finish(const QDBusMessage& reply);
+	void setRegistered(bool registered);
+
+	BluetoothAgentObject* object = nullptr;
+	QList<Request> mQueue;
+	bool mRegistered = false;
+	bool mExported = false;
+	int mInFlight = 0; // requests waiting for device properties
+	bool mCancelInFlight = false;
+};
+
+} // namespace qs::service::kde
