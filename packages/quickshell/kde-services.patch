+#include "brightness.hpp"
+
+#include <memory>
+
+#include <qdbusconnection.h>
+#include <qdbusextratypes.h>
+#include <qdbusmessage.h>
+#include <qdbuspendingcall.h>
+#include <qdbuspendingreply.h>
+#include <qdbusservicewatcher.h>
+#include <qlogging.h>
+#include <qloggingcategory.h>
+#include <qminmax.h>
+#include <qobject.h>
+#include <qstring.h>
+#include <qvariant.h>
+
+#include "../../core/logcat.hpp"
+
+namespace qs::service::kde {
+
+namespace {
+QS_LOGGING_CATEGORY(logBrightness, "quickshell.service.kde.brightness", QtWarningMsg);
+
+constexpr auto SERVICE = "org.kde.ScreenBrightness";
+constexpr auto PATH = "/org/kde/ScreenBrightness";
+constexpr auto INTERFACE = "org.kde.ScreenBrightness";
+constexpr auto DISPLAY_INTERFACE = "org.kde.ScreenBrightness.Display";
+constexpr auto PROPERTIES = "org.freedesktop.DBus.Properties";
+
+// SetBrightness flag: change silently, the slider itself shows the value.
+constexpr uint SUPPRESS_INDICATOR = 0x1;
+
+QString displayPath(const QString& name) { return QString(PATH) + '/' + name; }
+} // namespace
+
+ScreenBrightness::ScreenBrightness(QObject* parent): QObject(parent) {
+	auto bus = QDBusConnection::sessionBus();
+
+	// clang-format off
+	bus.connect(SERVICE, PATH, INTERFACE, "BrightnessChanged", this, SLOT(onBrightnessChanged(QString, int, QString, QString)));
+	bus.connect(SERVICE, PATH, INTERFACE, "BrightnessRangeChanged", this, SLOT(onBrightnessRangeChanged(QString, int, int)));
+	bus.connect(SERVICE, PATH, INTERFACE, "DisplayAdded", this, SLOT(onDisplaysChanged()));
+	bus.connect(SERVICE, PATH, INTERFACE, "DisplayRemoved", this, SLOT(onDisplaysChanged()));
+	// clang-format on
+
+	// powerdevil may start after the shell or restart.
+	auto* watcher = new QDBusServiceWatcher(
+	    SERVICE,
+	    bus,
+	    QDBusServiceWatcher::WatchForRegistration | QDBusServiceWatcher::WatchForUnregistration,
+	    this
+	);
+
+	QObject::connect(
+	    watcher,
+	    &QDBusServiceWatcher::serviceRegistered,
+	    this,
+	    &ScreenBrightness::onDisplaysChanged
+	);
+
+	QObject::connect(
+	    watcher,
+	    &QDBusServiceWatcher::serviceUnregistered,
+	    this,
+	    &ScreenBrightness::onServiceUnregistered
+	);
+
+	this->fetch();
+}
+
+QVariantList ScreenBrightness::displays() const {
+	QVariantList list;
+	list.reserve(this->mDisplays.size());
+	for (const auto& display: this->mDisplays) list.push_back(display);
+	return list;
+}
+
+int ScreenBrightness::indexOf(const QString& name) const {
+	for (int i = 0; i < this->mDisplays.size(); i++) {
+		if (this->mDisplays.at(i).value("name").toString() == name) return i;
+	}
+	return -1;
+}
+
+void ScreenBrightness::setBrightness(const QString& name, int value) {
+	const auto index = this->indexOf(name);
+	if (index < 0) return;
+
+	auto& display = this->mDisplays[index];
+	value = qBound(0, value, display.value("maxBrightness").toInt());
+	if (display.value("brightness").toInt() != value) {
+		display.insert("brightness", value);
+		emit this->displaysChanged();
+	}
+
+	auto message =
+	    QDBusMessage::createMethodCall(SERVICE, displayPath(name), DISPLAY_INTERFACE, "SetBrightness");
+	message.setArguments({value, SUPPRESS_INDICATOR});
+	QDBusConnection::sessionBus().asyncCall(message);
+}
+
+void ScreenBrightness::onBrightnessChanged(
+    const QString& name,
+    int value,
+    const QString& /*client*/,
+    const QString& /*context*/
+) {
+	const auto index = this->indexOf(name);
+	if (index < 0) return;
+	auto& display = this->mDisplays[index];
+	if (display.value("brightness").toInt() == value) return;
+	display.insert("brightness", value);
+	emit this->displaysChanged();
+}
+
+void ScreenBrightness::onBrightnessRangeChanged(const QString& name, int maxBrightness, int value) {
+	const auto index = this->indexOf(name);
+	if (index < 0) return;
+	auto& display = this->mDisplays[index];
+	display.insert("maxBrightness", maxBrightness);
+	display.insert("brightness", value);
+	emit this->displaysChanged();
+}
+
+void ScreenBrightness::onDisplaysChanged() { this->fetch(); }
+
+void ScreenBrightness::onServiceUnregistered() {
+	this->mGeneration++;
+	if (this->mDisplays.isEmpty()) return;
+	this->mDisplays.clear();
+	emit this->displaysChanged();
+}
+
+void ScreenBrightness::fetch() {
+	const auto generation = ++this->mGeneration;
+	auto bus = QDBusConnection::sessionBus();
+
+	auto message = QDBusMessage::createMethodCall(SERVICE, PATH, PROPERTIES, "Get");
+	message.setArguments({INTERFACE, "DisplaysDBusNames"});
+	auto* watcher = new QDBusPendingCallWatcher(bus.asyncCall(message), this);
+
+	QObject::connect(
+	    watcher,
+	    &QDBusPendingCallWatcher::finished,
+	    this,
+	    [this, generation](QDBusPendingCallWatcher* call) {
+		    call->deleteLater();
+		    if (generation != this->mGeneration) return;
+
+		    const QDBusPendingReply<QDBusVariant> reply = *call;
+		    if (reply.isError()) {
+			    // No powerdevil (or no controllable display) — nothing to show.
+			    qCDebug(logBrightness) << "Could not list displays:" << reply.error().message();
+			    if (!this->mDisplays.isEmpty()) {
+				    this->mDisplays.clear();
+				    emit this->displaysChanged();
+			    }
+			    return;
+		    }
+
+		    const auto names = reply.value().variant().toStringList();
+
+		    // Read every display, then publish them all at once in order.
+		    auto pending = std::make_shared<QList<QVariantMap>>(names.size());
+		    auto remaining = std::make_shared<qsizetype>(names.size());
+
+		    if (names.isEmpty()) {
+			    this->mDisplays.clear();
+			    emit this->displaysChanged();
+			    return;
+		    }
+
+		    for (qsizetype i = 0; i < names.size(); i++) {
+			    const auto& name = names.at(i);
+			    auto get = QDBusMessage::createMethodCall(SERVICE, displayPath(name), PROPERTIES, "GetAll");
+			    get.setArguments({DISPLAY_INTERFACE});
+			    auto* displayWatcher =
+			        new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(get), this);
+
+			    QObject::connect(
+			        displayWatcher,
+			        &QDBusPendingCallWatcher::finished,
+			        this,
+			        [this, generation, pending, remaining, i, name](QDBusPendingCallWatcher* call) {
+				        call->deleteLater();
+				        if (generation != this->mGeneration) return;
+
+				        const QDBusPendingReply<QVariantMap> reply = *call;
+				        if (reply.isError()) {
+					        qCWarning(logBrightness)
+					            << "Could not read display" << name << reply.error().message();
+				        } else {
+					        const auto props = reply.value();
+					        (*pending)[i] = QVariantMap {
+					            {"name", name},
+					            {"label", props.value("Label").toString()},
+					            {"internal", props.value("IsInternal").toBool()},
+					            {"brightness", props.value("Brightness").toInt()},
+					            {"maxBrightness", props.value("MaxBrightness").toInt()},
+					        };
+				        }
+
+				        if (--(*remaining) > 0) return;
+
+				        this->mDisplays.clear();
+				        for (const auto& display: *pending) {
+					        if (!display.isEmpty()) this->mDisplays.push_back(display);
+				        }
+				        emit this->displaysChanged();
+			        }
+			    );
+		    }
+	    }
+	);
+}
+
+} // namespace qs::service::kde
