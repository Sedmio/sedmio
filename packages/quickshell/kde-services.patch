+///! A file operation or other long job of a program.
+/// Copying files in Dolphin, extracting an archive in Ark, a download...
+/// The program reports its progress; the shell shows it.
+class JobView: public QObject {
+	Q_OBJECT;
+	QML_ELEMENT;
+	QML_UNCREATABLE("JobView can only be obtained from JobViewServer");
+	// clang-format off
+	Q_PROPERTY(int id READ id CONSTANT);
+	/// Desktop entry of the program (`org.kde.dolphin`), may be empty.
+	Q_PROPERTY(QString desktopEntry READ desktopEntry CONSTANT);
+	/// Name of the program when it gave one (or its process name).
+	Q_PROPERTY(QString appName READ appName CONSTANT);
+	/// Icon of the program when it gave one.
+	Q_PROPERTY(QString appIcon READ appIcon CONSTANT);
+	/// `running`, `suspended` or `finished`.
+	Q_PROPERTY(QString state READ state NOTIFY changed);
+	/// If the job can be canceled with @@cancel().
+	Q_PROPERTY(bool killable READ killable CONSTANT);
+	/// If the job can be paused with @@suspend().
+	Q_PROPERTY(bool suspendable READ suspendable CONSTANT);
+	/// What is being done, e.g. "Copying".
+	Q_PROPERTY(QString title READ title NOTIFY changed);
+	/// A status message, e.g. "Connecting to server".
+	Q_PROPERTY(QString infoMessage READ infoMessage NOTIFY changed);
+	/// 0-100.
+	Q_PROPERTY(int percent READ percent NOTIFY changed);
+	Q_PROPERTY(qreal processedBytes READ processedBytes NOTIFY changed);
+	Q_PROPERTY(qreal totalBytes READ totalBytes NOTIFY changed);
+	Q_PROPERTY(qreal processedFiles READ processedFiles NOTIFY changed);
+	Q_PROPERTY(qreal totalFiles READ totalFiles NOTIFY changed);
+	Q_PROPERTY(qreal processedDirectories READ processedDirectories NOTIFY changed);
+	Q_PROPERTY(qreal totalDirectories READ totalDirectories NOTIFY changed);
+	Q_PROPERTY(qreal processedItems READ processedItems NOTIFY changed);
+	Q_PROPERTY(qreal totalItems READ totalItems NOTIFY changed);
+	/// Bytes per second.
+	Q_PROPERTY(qreal speed READ speed NOTIFY changed);
+	/// Usually "Source" and "Destination" with a path or URL each.
+	Q_PROPERTY(QString descriptionLabel1 READ descriptionLabel1 NOTIFY changed);
+	Q_PROPERTY(QString descriptionValue1 READ descriptionValue1 NOTIFY changed);
+	Q_PROPERTY(QString descriptionLabel2 READ descriptionLabel2 NOTIFY changed);
+	Q_PROPERTY(QString descriptionValue2 READ descriptionValue2 NOTIFY changed);
+	/// Where the result goes (a folder URL), may be empty.
+	Q_PROPERTY(QString destUrl READ destUrl NOTIFY changed);
+	/// When finished: 0 on success, otherwise a KIO error code.
+	Q_PROPERTY(int error READ error NOTIFY changed);
+	/// When finished with an error: what went wrong.
+	Q_PROPERTY(QString errorText READ errorText NOTIFY changed);
+	/// The program does not want a notice when the job finishes well.
+	Q_PROPERTY(bool transient READ transient CONSTANT);
+	/// When the job started.
+	Q_PROPERTY(QDateTime started READ started CONSTANT);
+	/// When the job finished.
+	Q_PROPERTY(QDateTime ended READ ended NOTIFY changed);
+	// clang-format on
+
+public:
+	explicit JobView(int id, JobViewServer* server);
+
+	[[nodiscard]] int id() const { return this->mId; }
+	[[nodiscard]] QString desktopEntry() const { return this->mDesktopEntry; }
+	[[nodiscard]] QString appName() const { return this->mAppName; }
+	[[nodiscard]] QString appIcon() const { return this->mAppIcon; }
+	[[nodiscard]] QString state() const;
+	[[nodiscard]] bool killable() const { return this->mKillable; }
+	[[nodiscard]] bool suspendable() const { return this->mSuspendable; }
+	[[nodiscard]] QString title() const { return this->mTitle; }
+	[[nodiscard]] QString infoMessage() const { return this->mInfoMessage; }
+	[[nodiscard]] int percent() const { return this->mPercent; }
+	[[nodiscard]] qreal processedBytes() const { return static_cast<qreal>(this->mProcessedBytes); }
+	[[nodiscard]] qreal totalBytes() const { return static_cast<qreal>(this->mTotalBytes); }
+	[[nodiscard]] qreal processedFiles() const { return static_cast<qreal>(this->mProcessedFiles); }
+	[[nodiscard]] qreal totalFiles() const { return static_cast<qreal>(this->mTotalFiles); }
+	[[nodiscard]] qreal processedDirectories() const { return static_cast<qreal>(this->mProcessedDirs); }
+	[[nodiscard]] qreal totalDirectories() const { return static_cast<qreal>(this->mTotalDirs); }
+	[[nodiscard]] qreal processedItems() const { return static_cast<qreal>(this->mProcessedItems); }
+	[[nodiscard]] qreal totalItems() const { return static_cast<qreal>(this->mTotalItems); }
+	[[nodiscard]] qreal speed() const { return static_cast<qreal>(this->mSpeed); }
+	[[nodiscard]] QString descriptionLabel1() const { return this->mLabel1; }
+	[[nodiscard]] QString descriptionValue1() const { return this->mValue1; }
+	[[nodiscard]] QString descriptionLabel2() const { return this->mLabel2; }
+	[[nodiscard]] QString descriptionValue2() const { return this->mValue2; }
+	[[nodiscard]] QString destUrl() const { return this->mDestUrl; }
+	[[nodiscard]] int error() const { return this->mError; }
+	[[nodiscard]] QString errorText() const { return this->mErrorText; }
+	[[nodiscard]] bool transient() const { return this->mTransient; }
+	[[nodiscard]] QDateTime started() const { return this->mStarted; }
+	[[nodiscard]] QDateTime ended() const { return this->mEnded; }
+
+	/// Ask the program to cancel the job. If it does not answer within two
+	/// seconds, the job is dropped anyway.
+	Q_INVOKABLE void cancel();
+	/// Ask the program to pause the job.
+	Q_INVOKABLE void suspend();
+	/// Ask the program to continue the job.
+	Q_INVOKABLE void resume();
+	/// Forget a finished job. Does nothing while it runs.
+	Q_INVOKABLE void dismiss();
+
+	enum class State : quint8 { Running, Suspended, Finished };
+
+	// From the server.
+	void update(const QVariantMap& properties);
+	void terminate(uint errorCode, const QString& errorMessage);
+	void setV2Amount(bool total, quint64 amount, const QString& unit);
+	void setDescriptionField(uint number, const QString& name, const QString& value);
+	void emitDBusSignal(const QString& name);
+
+	QString mPath;
+	QString mOwner; // unique bus name of the program
+	QString mDesktopEntry;
+	QString mAppName;
+	QString mAppIcon;
+	State mState = State::Running;
+	bool mKillable = false;
+	bool mSuspendable = false;
+	bool mTransient = false;
+	bool mShown = false;
+	bool mShowOnTitle = false;
+	bool mShowOnTermination = false;
+	uint mV2Error = 0;
+	QTimer showTimer;
+	QTimer killTimer;
+
+signals:
+	void changed();
+
+private:
+	JobViewServer* server;
+	int mId;
+	QString mTitle;
+	QString mInfoMessage;
+	int mPercent = 0;
+	quint64 mProcessedBytes = 0;
+	quint64 mTotalBytes = 0;
+	quint64 mProcessedFiles = 0;
+	quint64 mTotalFiles = 0;
+	quint64 mProcessedDirs = 0;
+	quint64 mTotalDirs = 0;
+	quint64 mProcessedItems = 0;
+	quint64 mTotalItems = 0;
+	quint64 mSpeed = 0;
+	QString mLabel1;
+	QString mValue1;
+	QString mLabel2;
+	QString mValue2;
+	QString mDestUrl;
+	int mError = 0;
+	QString mErrorText;
+	QDateTime mStarted = QDateTime::currentDateTime();
+	QDateTime mEnded;
+};
+
+///! Progress of file operations and other jobs of programs.
+/// Takes over the job view server of plasmashell (org.kde.kuiserver and
+/// org.kde.JobViewServer): Dolphin, Ark and every other program using KIO
+/// report copying, moving, deleting and the like here instead of showing
+/// their own progress windows.
+///
+/// Jobs appear in @@jobs half a second after they start, so quick ones are
+/// never shown. Finished jobs stay until @@JobView.dismiss(), except
+/// canceled ones and transient ones that went well.
+class JobViewServer: public QObject {
+	Q_OBJECT;
+	QML_ELEMENT;
+	/// If the service is registered. False when another program (plasmashell)
+	/// already owns it.
+	Q_PROPERTY(bool active READ active NOTIFY activeChanged);
+	/// Shown jobs, oldest first.
+	QSDOC_TYPE_OVERRIDE(ObjectModel<qs::service::kde::JobView>*);
+	Q_PROPERTY(UntypedObjectModel* jobs READ jobs CONSTANT);
+
+public:
+	explicit JobViewServer(QObject* parent = nullptr);
+	~JobViewServer() override;
+	Q_DISABLE_COPY_MOVE(JobViewServer);
+
+	[[nodiscard]] bool active() const { return this->mActive; }
+	[[nodiscard]] ObjectModel<JobView>* jobs() { return &this->mJobs; }
+
+	// From the D-Bus object and the views.
+	QString requestView(
+	    const QString& desktopEntry,
+	    int capabilities,
+	    const QVariantMap& hints,
+	    const QString& sender
+	);
+	JobView* view(const QString& path) const { return this->views.value(path); }
+	void show(JobView* job);
+	void onTerminated(JobView* job);
+	void remove(JobView* job);
+	void emitJobUrlsChanged();
+
+signals:
+	void activeChanged();
+	/// A shown job finished (successfully or not) and stays in @@jobs.
+	void finished(JobView* job);
+
+private slots:
+	void onServiceUnregistered(const QString& service);
+
+private:
+	void unwatch(JobView* job);
+
+	JobViewServerObject* object = nullptr;
+	QDBusServiceWatcher* watcher = nullptr;
+	QHash<QString, JobView*> views;
+	ObjectModel<JobView> mJobs {this};
+	int nextId = 1;
+	bool mActive = false;
+};
+
+} // namespace qs::service::kde
