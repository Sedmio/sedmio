+#pragma once
+
+#include <qobject.h>
+#include <qqmlintegration.h>
+#include <qstring.h>
+#include <qtmetamacros.h>
+#include <qvariant.h>
+
+namespace qs::service::kde {
+
+///! Keyboard layouts of KWin.
+/// Reads and switches layouts through KWin's org.kde.keyboard service
+/// (/Layouts, org.kde.KeyboardLayouts) — the same one Plasma's layout
+/// indicator uses. Layouts themselves are set up in System Settings.
+class KeyboardLayouts: public QObject {
+	Q_OBJECT;
+	QML_ELEMENT;
+	QML_SINGLETON;
+	/// Configured layouts, in order. Each is an object with
+	/// `shortName` (`us`), `displayName` (short label set by the user,
+	/// often empty) and `longName` (`English (US)`).
+	Q_PROPERTY(QVariantList layouts READ layouts NOTIFY layoutsChanged);
+	/// Index of the active layout in @@layouts, -1 until known.
+	Q_PROPERTY(int currentIndex READ currentIndex NOTIFY currentIndexChanged);
+	/// The active layout (see @@layouts), or an empty object.
+	Q_PROPERTY(QVariantMap current READ current NOTIFY currentChanged);
+
+public:
+	explicit KeyboardLayouts(QObject* parent = nullptr);
+
+	[[nodiscard]] QVariantList layouts() const { return this->mLayouts; }
+	[[nodiscard]] int currentIndex() const { return this->mCurrentIndex; }
+	[[nodiscard]] QVariantMap current() const;
+
+	Q_INVOKABLE void switchToNext();
+	Q_INVOKABLE void switchToPrevious();
+	Q_INVOKABLE void setLayout(int index);
+
+signals:
+	void layoutsChanged();
+	void currentIndexChanged();
+	void currentChanged();
+
+private slots:
+	void onLayoutChanged(uint index);
+	void onLayoutListChanged();
+
+private:
+	void fetchLayouts();
+	void fetchCurrent();
+	void setCurrentIndex(int index);
+	void call(const QString& method, const QVariantList& args = {});
+
+	QVariantList mLayouts;
+	int mCurrentIndex = -1;
+};
+
+} // namespace qs::service::kde
