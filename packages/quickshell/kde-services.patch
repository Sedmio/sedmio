diff --git a/src/services/kde/osd.cpp b/src/services/kde/osd.cpp
new file mode 100644
index 0000000..25fb3bc
--- /dev/null
+++ b/src/services/kde/osd.cpp
@@ -0,0 +1,132 @@
+#include "osd.hpp"
+
+#include <qdbusconnection.h>
+#include <qlogging.h>
+#include <qloggingcategory.h>
+#include <qobject.h>
+#include <qrect.h>
+#include <qstring.h>
+
+#include "../../core/logcat.hpp"
+
+namespace qs::service::kde {
+
+namespace {
+QS_LOGGING_CATEGORY(logOsd, "quickshell.service.kde.osd", QtWarningMsg);
+
+constexpr auto SERVICE = "org.kde.plasmashell";
+constexpr auto PATH = "/org/kde/osdService";
+} // namespace
+
+OsdAdaptor::OsdAdaptor(OsdServer* server): server(server) {}
+
+void OsdAdaptor::brightnessChanged(int percent) {
+	emit this->server->progress("brightness", QString(), percent, 100, QString());
+}
+
+void OsdAdaptor::screenBrightnessChanged(
+    int percent,
+    const QString& /*displayId*/,
+    const QString& displayLabel,
+    int /*priority*/,
+    const QRect& /*screenRect*/
+) {
+	emit this->server->progress("brightness", QString(), percent, 100, displayLabel);
+}
+
+void OsdAdaptor::keyboardBrightnessChanged(int percent) {
+	emit this->server->progress("keyboardBrightness", QString(), percent, 100, QString());
+}
+
+void OsdAdaptor::volumeChanged(int percent) { this->volumeChanged(percent, 100); }
+
+void OsdAdaptor::volumeChanged(int percent, int maximumPercent) {
+	emit this->server->progress("volume", QString(), percent, maximumPercent, QString());
+}
+
+void OsdAdaptor::microphoneVolumeChanged(int percent) {
+	emit this->server->progress("microphone", QString(), percent, 100, QString());
+}
+
+void OsdAdaptor::mediaPlayerVolumeChanged(
+    int percent,
+    const QString& playerName,
+    const QString& playerIconName
+) {
+	emit this->server->progress("mediaPlayer", playerIconName, percent, 100, playerName);
+}
+
+void OsdAdaptor::kbdLayoutChanged(const QString& layoutName) {
+	emit this->server->message("layout", "keyboard-layout", layoutName);
+}
+
+void OsdAdaptor::virtualDesktopChanged(const QString& currentVirtualDesktopName) {
+	emit this->server->message("desktop", QString(), currentVirtualDesktopName);
+}
+
+void OsdAdaptor::touchpadEnabledChanged(bool touchpadEnabled) {
+	emit this->server->toggled("touchpad", touchpadEnabled);
+}
+
+void OsdAdaptor::wifiEnabledChanged(bool wifiEnabled) {
+	emit this->server->toggled("wifi", wifiEnabled);
+}
+
+void OsdAdaptor::bluetoothEnabledChanged(bool bluetoothEnabled) {
+	emit this->server->toggled("bluetooth", bluetoothEnabled);
+}
+
+void OsdAdaptor::wwanEnabledChanged(bool wwanEnabled) {
+	emit this->server->toggled("wwan", wwanEnabled);
+}
+
+void OsdAdaptor::virtualKeyboardEnabledChanged(bool virtualKeyboardEnabled) {
+	emit this->server->toggled("virtualKeyboard", virtualKeyboardEnabled);
+}
+
+void OsdAdaptor::powerManagementInhibitedChanged(bool inhibited) {
+	emit this->server->toggled("inhibited", inhibited);
+}
+
+void OsdAdaptor::powerProfileChanged(const QString& profile) {
+	emit this->server->message("powerProfile", QString(), profile);
+}
+
+void OsdAdaptor::showText(const QString& icon, const QString& text) {
+	emit this->server->message("text", icon, text);
+}
+
+void OsdAdaptor::hide() { emit this->server->hideRequested(); }
+
+OsdServer::OsdServer(QObject* parent): QObject(parent) {
+	auto bus = QDBusConnection::sessionBus();
+
+	if (!bus.isConnected()) {
+		qCWarning(logOsd) << "Could not connect to the session bus, OSD service unavailable.";
+		return;
+	}
+
+	if (!bus.registerObject(PATH, &this->adaptor, QDBusConnection::ExportAllSlots)) {
+		qCWarning(logOsd) << "Could not register" << PATH << "- another OsdServer exists?";
+		return;
+	}
+
+	if (!bus.registerService(SERVICE)) {
+		qCWarning(logOsd) << "Could not register" << SERVICE << "- is plasmashell running?";
+		bus.unregisterObject(PATH);
+		return;
+	}
+
+	qCInfo(logOsd) << "OSD service registered as" << SERVICE;
+	this->mActive = true;
+}
+
+OsdServer::~OsdServer() {
+	if (!this->mActive) return;
+
+	auto bus = QDBusConnection::sessionBus();
+	bus.unregisterObject(PATH);
+	bus.unregisterService(SERVICE);
+}
+
+} // namespace qs::service::kde
diff --git a/src/services/kde/osd.hpp b/src/services/kde/osd.hpp
new file mode 100644
index 0000000..3f307e6
--- /dev/null
+++ b/src/services/kde/osd.hpp
@@ -0,0 +1,96 @@
+#pragma once
+
+#include <qobject.h>
+#include <qqmlintegration.h>
+#include <qrect.h>
+#include <qstring.h>
+#include <qtmetamacros.h>
+
+namespace qs::service::kde {
+
+class OsdServer;
+
+// The D-Bus side of OsdServer: org.kde.osdService at /org/kde/osdService,
+// with the same methods plasmashell exports (plasma-workspace shell/osd.h).
+// kded (volume keys, media players), powerdevil (brightness) and KWin
+// (keyboard layout) call these on the org.kde.plasmashell name.
+class OsdAdaptor: public QObject {
+	Q_OBJECT;
+	Q_CLASSINFO("D-Bus Interface", "org.kde.osdService");
+
+public:
+	explicit OsdAdaptor(OsdServer* server);
+
+public slots:
+	void brightnessChanged(int percent);
+	void screenBrightnessChanged(
+	    int percent,
+	    const QString& displayId,
+	    const QString& displayLabel,
+	    int priority,
+	    const QRect& screenRect
+	);
+	void keyboardBrightnessChanged(int percent);
+	void volumeChanged(int percent);
+	void volumeChanged(int percent, int maximumPercent);
+	void microphoneVolumeChanged(int percent);
+	void mediaPlayerVolumeChanged(int percent, const QString& playerName, const QString& playerIconName);
+	void kbdLayoutChanged(const QString& layoutName);
+	void virtualDesktopChanged(const QString& currentVirtualDesktopName);
+	void touchpadEnabledChanged(bool touchpadEnabled);
+	void wifiEnabledChanged(bool wifiEnabled);
+	void bluetoothEnabledChanged(bool bluetoothEnabled);
+	void wwanEnabledChanged(bool wwanEnabled);
+	void virtualKeyboardEnabledChanged(bool virtualKeyboardEnabled);
+	void powerManagementInhibitedChanged(bool inhibited);
+	void powerProfileChanged(const QString& profile);
+	void showText(const QString& icon, const QString& text);
+	void hide();
+
+private:
+	OsdServer* server;
+};
+
+///! On-screen display requests from the rest of a Plasma session.
+/// Takes over plasmashell's org.kde.osdService: owns the org.kde.plasmashell
+/// bus name and turns every request into a signal. How (and whether) to show
+/// it is up to the shell.
+///
+/// Values are raw: percentages, names and on/off states; @@kind says what
+/// changed. Kinds:
+/// - progress: `volume`, `microphone`, `mediaPlayer` (label is the player
+///   name, icon its icon), `brightness` (label is the display name when
+///   known), `keyboardBrightness`
+/// - message: `layout`, `desktop`, `powerProfile` (`power-saver`,
+///   `balanced`, `performance`), `text` (free text with an icon)
+/// - toggled: `touchpad`, `wifi`, `bluetooth`, `wwan`, `virtualKeyboard`,
+///   `inhibited` (sleep and screen locking blocked)
+class OsdServer: public QObject {
+	Q_OBJECT;
+	QML_ELEMENT;
+	/// If the service is registered. False when another program (plasmashell)
+	/// already owns org.kde.plasmashell.
+	Q_PROPERTY(bool active READ active NOTIFY activeChanged);
+
+public:
+	explicit OsdServer(QObject* parent = nullptr);
+	~OsdServer() override;
+	Q_DISABLE_COPY_MOVE(OsdServer);
+
+	[[nodiscard]] bool active() const { return this->mActive; }
+
+signals:
+	void activeChanged();
+
+	void progress(QString kind, QString icon, int percent, int maximum, QString label);
+	void message(QString kind, QString icon, QString text);
+	void toggled(QString kind, bool enabled);
+	/// The OSD should go away now.
+	void hideRequested();
+
+private:
+	OsdAdaptor adaptor {this};
+	bool mActive = false;
+};
+
+} // namespace qs::service::kde
