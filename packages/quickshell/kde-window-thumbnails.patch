diff -ruN a/src/wayland/toplevel/kde_screencast.cpp b/src/wayland/toplevel/kde_screencast.cpp
--- a/src/wayland/toplevel/kde_screencast.cpp	1970-01-01 07:00:00.000000000 +0700
+++ b/src/wayland/toplevel/kde_screencast.cpp	2026-11-22 07:11:33.194191736 +0700
@@ -0,0 +1,135 @@
+#include "kde_screencast.hpp"
+#include <cstdint>
+
+#include <qlogging.h>
+#include <qloggingcategory.h>
+#include <qobject.h>
+#include <qwaylandclientextension.h>
+
+#include "../../core/logcat.hpp"
+#include "kde_toplevel.hpp"
+#include "qml.hpp"
+
+namespace qs::wayland::toplevel {
+
+QS_LOGGING_CATEGORY(logScreencast, "quickshell.wayland.kdeScreencast", QtWarningMsg);
+
+namespace {
+// Version 6 replaces the created(node) event with an object serial; the
+// node is what PipeWireSourceItem takes, so stay on 5.
+constexpr int SCREENCAST_VERSION = 5;
+constexpr uint32_t POINTER_HIDDEN = 1;
+} // namespace
+
+namespace kde {
+
+ScreencastManager::ScreencastManager(): QWaylandClientExtensionTemplate(SCREENCAST_VERSION) {
+	this->initialize();
+}
+
+ScreencastManager* ScreencastManager::instance() {
+	static auto* instance = new ScreencastManager(); // NOLINT
+	return instance;
+}
+
+ScreencastStream::ScreencastStream(::zkde_screencast_stream_unstable_v1* stream, QObject* parent)
+    : QObject(parent)
+    , QtWayland::zkde_screencast_stream_unstable_v1(stream) {}
+
+ScreencastStream::~ScreencastStream() {
+	if (this->isInitialized()) this->close();
+}
+
+void ScreencastStream::zkde_screencast_stream_unstable_v1_created(uint32_t node) {
+	emit this->created(node);
+}
+
+void ScreencastStream::zkde_screencast_stream_unstable_v1_failed(const QString& error) {
+	emit this->failed(error);
+}
+
+void ScreencastStream::zkde_screencast_stream_unstable_v1_closed() { emit this->closed(); }
+
+} // namespace kde
+
+WindowStream::WindowStream(QObject* parent): QObject(parent) {
+	QObject::connect(
+	    kde::ScreencastManager::instance(),
+	    &QWaylandClientExtension::activeChanged,
+	    this,
+	    &WindowStream::update
+	);
+}
+
+Toplevel* WindowStream::toplevel() const { return this->mToplevel; }
+
+void WindowStream::setToplevel(Toplevel* toplevel) {
+	if (toplevel == this->mToplevel) return;
+	if (this->mToplevel != nullptr) QObject::disconnect(this->mToplevel, nullptr, this, nullptr);
+
+	this->stop();
+	this->mToplevel = toplevel;
+	if (toplevel != nullptr) {
+		QObject::connect(toplevel, &QObject::destroyed, this, &WindowStream::update);
+	}
+
+	emit this->toplevelChanged();
+	this->update();
+}
+
+bool WindowStream::active() const { return this->mActive; }
+
+void WindowStream::setActive(bool active) {
+	if (active == this->mActive) return;
+	this->mActive = active;
+	emit this->activeChanged();
+	this->update();
+}
+
+quint32 WindowStream::nodeId() const { return this->mNodeId; }
+
+void WindowStream::setNodeId(quint32 nodeId) {
+	if (nodeId == this->mNodeId) return;
+	this->mNodeId = nodeId;
+	emit this->nodeIdChanged();
+}
+
+// Not deleted right away: stop() also runs from the stream's own events.
+void WindowStream::stop() {
+	if (this->mStream != nullptr) {
+		QObject::disconnect(this->mStream, nullptr, this, nullptr);
+		this->mStream->deleteLater();
+		this->mStream = nullptr;
+	}
+	this->setNodeId(0);
+}
+
+void WindowStream::update() {
+	if (!this->mActive || this->mToplevel == nullptr) {
+		this->stop();
+		return;
+	}
+	if (this->mStream != nullptr) return;
+
+	auto* manager = kde::ScreencastManager::instance();
+	if (!manager->isActive()) return; // not bound (yet); activeChanged retries
+
+	auto* handle = dynamic_cast<kde::ToplevelHandle*>(this->mToplevel->implHandle());
+	if (handle == nullptr || handle->uuid().isEmpty()) return;
+
+	this->mStream = new kde::ScreencastStream(
+	    manager->stream_window(handle->uuid(), POINTER_HIDDEN),
+	    this
+	);
+
+	QObject::connect(this->mStream, &kde::ScreencastStream::created, this, &WindowStream::setNodeId);
+	QObject::connect(this->mStream, &kde::ScreencastStream::failed, this, [this](const QString& error) {
+		qCWarning(logScreencast) << "Window stream failed:" << error;
+		this->stop();
+	});
+	QObject::connect(this->mStream, &kde::ScreencastStream::closed, this, [this]() {
+		this->stop();
+	});
+}
+
+} // namespace qs::wayland::toplevel
diff -ruN a/src/wayland/toplevel/kde_screencast.hpp b/src/wayland/toplevel/kde_screencast.hpp
--- a/src/wayland/toplevel/kde_screencast.hpp	1970-01-01 07:00:00.000000000 +0700
+++ b/src/wayland/toplevel/kde_screencast.hpp	2026-11-22 07:11:09.187681282 +0700
@@ -0,0 +1,96 @@
+#pragma once
+
+#include <cstdint>
+
+#include <qobject.h>
+#include <qpointer.h>
+#include <qqmlintegration.h>
+#include <qstring.h>
+#include <qtmetamacros.h>
+#include <qtypes.h>
+#include <qwayland-zkde-screencast-unstable-v1.h>
+#include <qwaylandclientextension.h>
+
+#include "qml.hpp"
+
+namespace qs::wayland::toplevel {
+
+namespace kde {
+
+// KWin's screencasting protocol: a PipeWire stream with a picture of one
+// window, the way Plasma's task manager shows window thumbnails. KWin only
+// lets clients bind it when their .desktop file lists it in
+// X-KDE-Wayland-Interfaces (see assets/org.quickshell.desktop).
+class ScreencastManager
+    : public QWaylandClientExtensionTemplate<ScreencastManager>
+    , public QtWayland::zkde_screencast_unstable_v1 {
+public:
+	static ScreencastManager* instance();
+
+protected:
+	explicit ScreencastManager();
+};
+
+class ScreencastStream
+    : public QObject
+    , public QtWayland::zkde_screencast_stream_unstable_v1 {
+	Q_OBJECT;
+
+public:
+	explicit ScreencastStream(::zkde_screencast_stream_unstable_v1* stream, QObject* parent);
+	~ScreencastStream() override;
+	Q_DISABLE_COPY_MOVE(ScreencastStream);
+
+signals:
+	void created(quint32 node);
+	void failed(const QString& error);
+	void closed();
+
+protected:
+	void zkde_screencast_stream_unstable_v1_created(uint32_t node) override;
+	void zkde_screencast_stream_unstable_v1_failed(const QString& error) override;
+	void zkde_screencast_stream_unstable_v1_closed() override;
+};
+
+} // namespace kde
+
+///! Live picture of a window from another application (KWin only).
+/// While @@active is true, KWin streams the window through PipeWire;
+/// @@nodeId is the stream for `PipeWireSourceItem` from `org.kde.pipewire`.
+/// Streams cost a little GPU time: keep them active only while shown.
+class WindowStream: public QObject {
+	Q_OBJECT;
+	Q_PROPERTY(qs::wayland::toplevel::Toplevel* toplevel READ toplevel WRITE setToplevel NOTIFY toplevelChanged);
+	Q_PROPERTY(bool active READ active WRITE setActive NOTIFY activeChanged);
+	/// PipeWire node of the stream, 0 until KWin has created it.
+	Q_PROPERTY(quint32 nodeId READ nodeId NOTIFY nodeIdChanged);
+	QML_ELEMENT;
+
+public:
+	explicit WindowStream(QObject* parent = nullptr);
+
+	[[nodiscard]] Toplevel* toplevel() const;
+	void setToplevel(Toplevel* toplevel);
+	[[nodiscard]] bool active() const;
+	void setActive(bool active);
+	[[nodiscard]] quint32 nodeId() const;
+
+signals:
+	void toplevelChanged();
+	void activeChanged();
+	void nodeIdChanged();
+
+private slots:
+	void update();
+
+private:
+	void stop();
+	void setNodeId(quint32 nodeId);
+
+	QPointer<Toplevel> mToplevel;
+	bool mActive = false;
+	quint32 mNodeId = 0;
+	kde::ScreencastStream* mStream = nullptr;
+};
+
+} // namespace qs::wayland::toplevel
