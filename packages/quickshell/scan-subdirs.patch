+
+	// Every directory under the config root, not only the ones something imports:
+	// files loaded at runtime by path (Loader.source) can then use their sibling
+	// types, singletons and "import qs.<dir>" like statically imported ones do.
+	auto it = QDirIterator(
+	    this->rootPath.path(),
+	    QDir::Dirs | QDir::NoDotAndDotDot,
+	    QDirIterator::Subdirectories
+	);
+	while (it.hasNext()) {
+		auto dir = it.next();
+		if (dir.sliced(this->rootPath.path().length()).contains("/.")) continue;
+		this->scanDir(QDir(dir));
+	}
