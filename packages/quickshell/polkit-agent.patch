+// polkitd (по крайней мере до 128) после первого же запроса пароля
+// оставляет у себя LANGUAGE=C, и сообщения, переведённые через gettext
+// (gettext-domain в .policy — так у всего systemd), дальше приходят
+// непереведёнными. Переводим сами, в локали оболочки. Не вышло — как есть.
+static QString localize_message(const gchar* actionId, const gchar* message, PolkitDetails* details) {
+	const auto original = QString::fromUtf8(message);
+	auto translate = [](const QByteArray& domain, const QByteArray& text) {
+		return QString::fromUtf8(dgettext(domain.constData(), text.constData()));
+	};
+
+	// Сообщение из подробностей запроса (systemd: «запустить $(unit)»).
+	if (details != nullptr) {
+		const auto* domain = polkit_details_lookup(details, "polkit.gettext_domain");
+		const auto* raw = polkit_details_lookup(details, "polkit.message");
+		if (domain != nullptr && raw != nullptr) {
+			auto text = translate(domain, raw);
+			if (text == QString::fromUtf8(raw)) return original;
+			static const QRegularExpression property(QStringLiteral("\\$\\(([^)]*)\\)"));
+			QString result;
+			qsizetype last = 0;
+			for (auto it = property.globalMatch(text); it.hasNext();) {
+				const auto match = it.next();
+				const auto* value = polkit_details_lookup(details, match.captured(1).toUtf8().constData());
+				if (value == nullptr) return original;
+				result += text.mid(last, match.capturedStart() - last) + QString::fromUtf8(value);
+				last = match.capturedEnd();
+			}
+			return result + text.mid(last);
+		}
+	}
+
+	// Сообщение действия: <message gettext-domain="...">.
+	const auto id = QString::fromUtf8(actionId);
+	const QDir actions(QStringLiteral("/usr/share/polkit-1/actions"));
+	for (const auto& name: actions.entryList({QStringLiteral("*.policy")}, QDir::Files)) {
+		QFile file(actions.filePath(name));
+		if (!file.open(QIODevice::ReadOnly)) continue;
+		QXmlStreamReader xml(&file);
+		bool inside = false;
+		while (!xml.atEnd()) {
+			xml.readNext();
+			if (xml.isStartElement() && xml.name() == QLatin1String("action")) {
+				inside = xml.attributes().value(QLatin1String("id")) == id;
+			} else if (xml.isEndElement() && xml.name() == QLatin1String("action")) {
+				if (inside) return original;
+			} else if (inside && xml.isStartElement() && xml.name() == QLatin1String("message")) {
+				const auto domain = xml.attributes().value(QLatin1String("gettext-domain")).toUtf8();
+				const auto text = xml.readElementText().trimmed();
+				if (!domain.isEmpty() && text == original) return translate(domain, text.toUtf8());
+			}
+		}
+	}
+	return original;
+}
