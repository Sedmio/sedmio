# Maintainer: Sedmio <https://github.com/Sedmio>
#
# «Параметры» — настройки Sedmio вместо параметров системы KDE. Интерфейс на
# QML в стиле оболочки; работа — те же движки, что у KDE: экраны —
# libkscreen (применяет и запоминает KWin), время и имя компьютера —
# systemd (timedated, hostnamed, пароль спрашивает polkit), обои — файл
# ~/.config/sedmio/wallpaper.json, его читает оболочка; мышь — KWin,
# раскладки — kxkbrc, питание — powerdevilrc (демоны остаются от KDE),
# звук — PulseAudio API (pipewire-pulse) через pulseaudio-qt, как plasma-pa,
# учётная запись — AccountsService, вход без пароля — sedmio-login,
# ночная подсветка — kwinrc [NightColor] и knighttimerc (KWin и knighttimed).
#
# Разделы пока: Экран, Обои, Мышь и тачпад, Клавиатура, Звук, Сеть, Bluetooth,
# Питание, Программы по умолчанию, Автозапуск, Учётная запись, Дата и время,
# Обновление (работа — пакет sedmio-update), О системе. «Параметров KDE»
# (systemsettings) нет — ушли с Plasma; кнопка
# «Дополнительно» есть там, где раздел KDE остался в системе (звук,
# питание, типы файлов): открывает его окном kcmshell6.
#
# Meta+P (и подключение второго экрана) показывает наш выбор режима экранов
# (--display-switcher) вместо окна kscreen_osd_service: подмена через
# drop-in к plasma-kscreen-osd.service, kscreen остаётся запасным.
#
# Исходники — app/ рядом с этим файлом (src/ занята makepkg).

pkgname=sedmio-preferences
pkgver=0.1.0
pkgrel=34
pkgdesc="Sedmio: приложение «Параметры» на QML"
arch=('x86_64')
url="https://github.com/Sedmio/sedmio"
license=('MIT')
depends=(
  'qt6-base'
  'qt6-declarative'
  'kcoreaddons'
  'kwindowsystem'
  'libkscreen'
  'kconfig'
  'layer-shell-qt'  # окно выбора режима экранов поверх всего
  'kscreen'         # kded зовёт наш выбор режима экранов (plasma-kscreen-osd.service.d)
  'pulseaudio-qt'   # «Звук»: устройства, громкость, профили карт
  'libpulse'        # уровень микрофона
  'pipewire'        # pw-play — «Проверить звук»
  'bluez-qt'        # «Bluetooth» (модуль QML org.kde.bluezqt)
  'networkmanager-qt' # «Сеть»: сохранённые сети, адреса, DNS
  'accountsservice' # имя, картинка и пароль учётной записи
  'libxcrypt'       # хэш нового пароля
  'kservice'
  'libxkbcommon'    # названия раскладок (xkbregistry)
  'icu'             # русские названия городов в часовых поясах
  'kcmutils'        # kcmshell6: «Дополнительно» — раздел KDE окном
  'breeze-icons'
  # Шрифт Onest (sedmio-branding) и цвета (sedmio-theme, модуль Sedmio.Style)
  # сюда не вписаны: makepkg ставит зависимости компилируемого пакета на
  # машину сборки, а наших пакетов в репозиториях Arch нет. Их тянет
  # sedmio-base.
)
makedepends=(
  'cmake'
  'ninja'
)

build() {
  cmake -G Ninja -S "$startdir/app" -B build -W no-dev \
    -D CMAKE_BUILD_TYPE=RelWithDebInfo \
    -D CMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  cp -a "$startdir/files/." "$pkgdir/"
  find "$pkgdir/usr/share/kglobalaccel" -type d -exec chmod 755 {} +
  chmod 644 "$pkgdir/usr/lib/systemd/user/plasma-kscreen-osd.service.d/10-sedmio.conf"
}
