[Desktop Entry]
Type=Application
Name=Settings
Name[ru]=Параметры
GenericName=System Settings
GenericName[ru]=Параметры системы
Comment=Display, wallpaper, date and time, about this computer
Comment[ru]=Экран, обои, дата и время, сведения о компьютере
Icon=preferences-system
Exec=sedmio-preferences %u
Terminal=false
Categories=Qt;KDE;Settings;
Keywords=settings;preferences;display;screen;resolution;night light;wallpaper;mouse;touchpad;keyboard;layout;sound;volume;network;wifi;wi-fi;ip address;dns;vpn;wireguard;audio;microphone;power;sleep;default applications;autostart;startup;browser;account;user;password;avatar;autologin;time;timezone;hostname;
Keywords[ru]=параметры;настройки;экран;монитор;разрешение;масштаб;ночная подсветка;ночной режим;тёплые цвета;обои;фон;мышь;тачпад;клавиатура;раскладка;язык ввода;звук;громкость;динамики;наушники;микрофон;сеть;интернет;wi-fi;вайфай;пароль wi-fi;ip-адрес;dns;vpn;впн;wireguard;блютуз;наушники bluetooth;сопряжение;питание;сон;спящий режим;программы по умолчанию;автозапуск;автозагрузка;запуск при входе;браузер;учётная запись;пользователь;пароль;аватар;картинка пользователя;вход без пароля;время;дата;часовой пояс;имя компьютера;о системе;
StartupNotify=true
# Как Win+I в Windows (раньше эти клавиши были у параметров KDE).
X-KDE-Shortcuts=Meta+I
Actions=About;
X-KDE-Wayland-Interfaces=kde_output_management_v2,kde_output_device_v2

# Win+Pause — «О системе», как в Windows.
[Desktop Action About]
Name=About this computer
Name[ru]=О системе
Icon=help-about
Exec=sedmio-preferences about
X-KDE-Shortcuts=Meta+Pause
