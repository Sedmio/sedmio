# Параметры KDE под своим именем: «Параметры» в Sedmio — наше приложение
# (sedmio-preferences), а это — всё остальное, чего у нас пока нет. Meta+I
# открывает наши (/usr/share/kglobalaccel/sedmio-preferences.desktop).
# Файл перекрывает одноимённый из systemsettings: каталог стоит первым в
# XDG_DATA_DIRS (/usr/lib/environment.d/60-sedmio-data-dirs.conf).
[Desktop Entry]
Exec=systemsettings
Icon=systemsettings
Type=Application
SingleMainWindow=true
X-DocPath=systemsettings/index.html
StartupNotify=true
X-KDE-Shortcuts=
OnlyShowIn=KDE;
Name=KDE Settings
Name[ru]=Параметры KDE
GenericName=System Settings
GenericName[ru]=Все параметры KDE
Comment=All KDE settings: what Sedmio Settings do not have yet
Comment[ru]=Все параметры KDE: то, чего ещё нет в «Параметрах»
X-DBUS-StartupType=Unique
X-DBUS-ServiceName=org.kde.systemsettings
Categories=Qt;KDE;Settings;
Keywords=systemsettings;kde;
Keywords[ru]=параметры kde;настройки kde;
