# Maintainer: Sedmio <https://github.com/Sedmio>
#
# «Файлы» — файловый менеджер Sedmio вместо Dolphin. Интерфейс на QML в
# стиле оболочки, работа с файлами — KIO (фреймворк KDE, не Plasma): те же
# корзина, сеть, флешки, миниатюры и ход копирования в оболочке. Вопросы
# заданий («файл уже есть», «чем открыть») — свои окна вместо окон KIO.
#
# Один процесс на сеанс, держит org.freedesktop.FileManager1: «показать в
# папке» из других программ и повторный запуск открывают окно в нём.
# Программа по умолчанию для папок — /etc/xdg/mimeapps.list в sedmio-settings.
#
# Здесь же окно «Открыть» / «Сохранить как» для всех программ
# (sedmio-files --portal, служба xdg-desktop-portal; см. app/portal.h).
#
# Здесь же sedmio-devices: уведомление о подключённой флешке с кнопками
# «Открыть» и «Извлечь» (в Plasma — апплет устройств на панели).
#
# Исходники — app/ рядом с этим файлом (src/ занята makepkg).

pkgname=sedmio-files
pkgver=0.1.0
pkgrel=13
pkgdesc="Sedmio: файловый менеджер «Файлы» на QML и KIO"
arch=('x86_64')
url="https://github.com/Sedmio/sedmio"
license=('MIT')
depends=(
  'qt6-base'
  'qt6-declarative'
  'kcoreaddons'
  'kio'
  'kio-extras'      # миниатюры картинок, sftp, smb
  'kservice'
  'solid'
  'kwindowsystem'
  'breeze-icons'
  'xdg-desktop-portal-kde'  # запасное окно выбора файлов
  # Шрифт Onest (sedmio-branding) и цвета (sedmio-theme, модуль Sedmio.Style)
  # сюда не вписаны: makepkg ставит зависимости компилируемого пакета на
  # машину сборки, а наших пакетов в репозиториях Arch нет. Их тянет
  # sedmio-base.
)
# Свой kde-portals.conf (окно выбора файлов) — правки администратора не
# затираются обновлением.
backup=('etc/xdg/xdg-desktop-portal/kde-portals.conf')
makedepends=(
  'cmake'
  'ninja'
)

build() {
  cmake -G Ninja -S "$startdir/app" -B build -W no-dev \
    -D CMAKE_BUILD_TYPE=RelWithDebInfo \
    -D CMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # Уведомления о флешках — в каждом сеансе, как оболочка Sedmio.
  install -dm755 "$pkgdir/usr/lib/systemd/user/sedmio-session.target.wants"
  ln -s ../sedmio-devices.service "$pkgdir/usr/lib/systemd/user/sedmio-session.target.wants/sedmio-devices.service"
  # Meta+E: глобальное сочетание из X-KDE-Shortcuts в .desktop.
  install -dm755 "$pkgdir/usr/share/kglobalaccel"
  ln -s ../applications/sedmio-files.desktop "$pkgdir/usr/share/kglobalaccel/sedmio-files.desktop"
}
