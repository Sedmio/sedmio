# Maintainer: Sedmio <https://github.com/Sedmio>
#
# Метапакет: что входит в систему на обеих машинах.
# Убрать программу из системы = убрать её отсюда.
#
# Службы не включаются из пакета напрямую: для этого есть systemd-пресет.
# Установщик после установки пакетов выполняет `systemctl preset-all`.

pkgname=sedmio-base
pkgver=0.1.0
pkgrel=25
pkgdesc="Sedmio: состав системы"
arch=('any')
url="https://github.com/Sedmio/sedmio"
license=('MIT')
depends=(
  'sedmio-settings'
  'sedmio-keyring'          # ключ подписи пакетов [sedmio]
  'sedmio-theme'            # темы: цвета всех наших программ (модуль Sedmio.Style)
  'sedmio-shell'            # своя оболочка вместо plasmashell (тянет форк quickshell)
  'sedmio-xembedsniproxy'   # значки старых программ X11 (Wine, Java, GTK2) в трее
  'sedmio-login'            # экраны входа (greetd вместо SDDM) и блокировки
  'sedmio-session'          # сеанс: запуск, выход, выключение (вместо startplasma и ksmserver)

  # Службы и части KDE — без Plasma (plasma-workspace, plasma-desktop и
  # systemsettings в систему не входят: всё их — своё, docs/decisions.md §15)
  'kscreen'
  'plasma-nm'
  'plasma-pa'
  'bluedevil'
  'powerdevil'
  'power-profiles-daemon'
  'kde-gtk-config'
  'breeze-gtk'
  'adw-gtk-theme'           # вид программ GTK3 как у GTK4/libadwaita, цвета из темы Sedmio
  'darkly'                  # стиль программ Qt (Widgets): скругления, тени, цвета темы
  'xdg-desktop-portal-kde'
  'xdg-desktop-portal-gtk'  # портал уведомлений (и настройки для программ GTK)
  'plasma-integration'      # вид программ Qt и KDE: диалоги, цвета, значки
  'qt6-imageformats'        # картинки WebP, TIFF, ICO в программах Qt (обои, «Файлы»; раньше тянул Spectacle)
  'qqc2-desktop-style'      # вид разделов KDE (kcmshell6) и программ на Kirigami
  'kde-cli-tools'           # типы файлов (kcm_filetypes), kde-open, kioclient
  'polkit-kde-agent'        # запасной агент паролей (sedmio-agents-fallback)
  'xorg-xwayland'           # программы и игры для X11
  'xdg-user-dirs'           # «Документы», «Загрузки» и т. п. на русском
  'ocean-sound-theme'       # звуки уведомлений и «Проверить звук»

  # Программы
  'sedmio-files'            # «Файлы» вместо Dolphin
  'sedmio-preferences'      # «Параметры» перед параметрами KDE
  'sedmio-tasks'            # диспетчер задач (Ctrl+Shift+Esc)
  'sedmio-screenshot'       # снимки экрана («Ножницы»: PrtSc, Win+Shift+S)
  'sedmio-update'           # обновления и снимки системы btrfs («Параметры» → «Обновление»)
  'sedmio-store'            # «Программы»: магазин (Arch, Flathub, AUR)
  'sedmio-skills'           # навыки для нейронок: как устроена Sedmio и как её менять
  'ghostty'                 # терминал (настройки — /etc/skel/.config/ghostty, тема — sedmio-settings)
  'ark'
  'firefox'
  'firefox-i18n-ru'

  # Звук, сеть, Bluetooth
  'pipewire'
  'pipewire-pulse'
  'wireplumber'
  'rtkit'                   # PipeWire в реальном времени: без него звук трещит под нагрузкой
  'networkmanager'
  'bluez'
  'bluez-utils'

  # Шрифты
  'inter-font'
  'ttf-jetbrains-mono'
  'noto-fonts'
  'noto-fonts-cjk'
  'noto-fonts-emoji'

  # Система
  'amd-ucode'
  'reflector'
  'git'                     # нужен почти всегда, в т.ч. dev-setup.sh
  'which'                   # установщик (Calamares) вызывает which в новой системе
  'mkinitcpio'
  'plymouth'                # заставка при загрузке (тема — sedmio-branding; хук initramfs ставит установщик)

  # Явный выбор там, где у зависимости несколько поставщиков,
  # иначе pacstrap берёт первый по алфавиту:
  'qt6-multimedia-ffmpeg'   # qt6-multimedia-backend
)

# Переход с SDDM на greetd на уже установленной системе: см. sedmio-base.install
install=sedmio-base.install

package() {
  install -Dm644 "$startdir/80-sedmio.preset" \
    "$pkgdir/usr/lib/systemd/system-preset/80-sedmio.preset"
}
