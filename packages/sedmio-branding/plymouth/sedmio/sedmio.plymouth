[Plymouth Theme]
Name=Sedmio
Name[ru]=Sedmio
Description=Заставка Sedmio: знак и кольцо-индикатор на тёмно-зелёном
ModuleName=two-step

[two-step]
Font=Onest 12
TitleFont=Onest 22
MonospaceFont=monospace 11
ImageDir=/usr/share/plymouth/themes/sedmio
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.75
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.3
HorizontalAlignment=.5
VerticalAlignment=.68
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.45
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x1f2a23
BackgroundEndColor=0x111814
ProgressBarBackgroundColor=0x2c3a31
ProgressBarForegroundColor=0xa8c59f
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Устанавливаются обновления…
SubTitle=Не выключайте компьютер

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Обновление системы…
SubTitle=Не выключайте компьютер

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Обновление прошивки…
SubTitle=Не выключайте компьютер

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Сброс системы…
SubTitle=Не выключайте компьютер
