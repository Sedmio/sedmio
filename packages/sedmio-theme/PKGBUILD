# Maintainer: Sedmio <https://github.com/Sedmio>
#
# Темы Sedmio: откуда все наши программы (оболочка, окна паролей, вход и
# блокировка, «Параметры», «Файлы», диспетчер задач) берут цвета, шрифт,
# скругления и движение. QML-модуль Sedmio.Style (синглтон Theme) и
# рамки окон KWin (org.sedmio.decoration) читают файл выбранной темы и
# следят за ним — тема меняется на ходу.
#
#   /usr/share/sedmio/themes/<тема>/theme.json   — темы (и ~/.local/share)
#   ~/.config/sedmio/theme                      — выбор (первая строка);
#                                                  по умолчанию /etc/xdg/sedmio/theme,
#                                                  нет и его — «sedmio»
#
# Тема по умолчанию вшита в модуль и в рамки: файла нет или он битый —
# берётся она. Плагина рамок нет — KWin рисует Breeze.
#
# Служба sedmio-theme-sync (пользовательская, включена для всех) пишет из
# темы цветовую схему KDE Sedmio в ~/.local/share/color-schemes и, если
# выбрана она, применяет: чужие программы на Qt/KDE и через kde-gtk-config
# GTK — в тех же цветах. Не запустилась — остаётся запасная схема Sedmio из
# sedmio-settings.
#
# Исходники — code/ (common — чтение темы, style — QML-модуль, decoration —
# рамки) и themes/ рядом с этим файлом (src/ занята makepkg).

pkgname=sedmio-theme
pkgver=0.2.0
pkgrel=5
pkgdesc="Sedmio: темы оформления, модуль Sedmio.Style и рамки окон"
arch=('x86_64')
url="https://github.com/Sedmio/sedmio"
license=('MIT')
depends=(
  'qt6-base'
  'qt6-declarative'
  'kdecoration'
  'kcoreaddons'
  'kconfig'
)
makedepends=(
  'cmake'
  'ninja'
  'extra-cmake-modules'
)

build() {
  cmake -G Ninja -S "$startdir/code" -B build \
    -D CMAKE_BUILD_TYPE=RelWithDebInfo \
    -D CMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -dm755 "$pkgdir/usr/lib/systemd/user/sedmio-session.target.wants"
  ln -s ../sedmio-theme-sync.service "$pkgdir/usr/lib/systemd/user/sedmio-session.target.wants/sedmio-theme-sync.service"
}
