<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Вход без пароля из «Параметров» (/usr/lib/sedmio/set-autologin).
     Включить его — значит пустить в систему любого, кто включит
     компьютер, поэтому спрашиваем пароль. -->
<policyconfig>
  <vendor>Sedmio</vendor>
  <vendor_url>https://github.com/Sedmio/sedmio</vendor_url>

  <action id="org.sedmio.login.set-autologin">
    <description>Change sign-in without a password</description>
    <description xml:lang="ru">Изменить вход без пароля</description>
    <message>Authentication is required to change sign-in without a password</message>
    <message xml:lang="ru">Чтобы изменить вход без пароля, введите пароль</message>
    <icon_name>system-users</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/sedmio/set-autologin</annotate>
  </action>
</policyconfig>
