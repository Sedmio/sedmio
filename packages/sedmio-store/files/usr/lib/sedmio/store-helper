#!/usr/bin/python3 -I
# «Программы» (sedmio-store): поставить или удалить пакеты из репозиториев
# Arch. От root — через pkexec (org.sedmio.store.policy).
#
#   store-helper install <пакет>...       pacman -S --needed
#   store-helper install-deps <пакет>...  то же, но «как зависимости» (для сборки из AUR)
#   store-helper install-files [--asdeps] <файл>...
#                                         pacman -U собранного из AUR; файлы —
#                                         только из ~/.cache/sedmio-store/aur
#                                         того, кто вызвал pkexec
#   store-helper remove <пакет>...        pacman -Rs (с ненужными больше зависимостями)
#
# Без -Sy: базы пакетов обновляет только обновление системы («Параметры» →
# «Обновление»). Иначе новый пакет встанет на старые библиотеки —
# частичное обновление, после которого Arch ломается. Если базы устарели и
# нужной версии на зеркалах уже нет — так и говорим (код 4), и магазин
# предлагает обновить систему.
#
# Снимок системы перед установкой делает хук sedmio-update
# (05-sedmio-snapshot.hook), как перед любой работой pacman.
#
# pacman идёт отдельной службой: закрыли «Программы» или они упали —
# установка всё равно доделается, а не оборвётся на полпути.
#
# Вывод для магазина — строки:
#   STEP <что делаем>       PROGRESS <n> <из>       ERROR <код> <текст>
# Коды выхода: 0 — готово, 1 — ошибка, 2 — неверный вызов, 3 — занято
# (идёт другая установка или обновление), 4 — базы пакетов устарели.

import os
import pwd
import re
import shutil
import stat
import subprocess
import sys

NAME_RE = re.compile(r"^[a-z0-9@_+][a-z0-9@._+-]*$")
LOG = "/run/sedmio-store/last.log"
# Собранное из AUR: помощник копирует файлы сюда (root) и ставит копии —
# пока pacman их читает, пользователь их уже не подменит.
AUR_CACHE = "/var/cache/sedmio-store/aur"
FILE_RE = re.compile(r"^[A-Za-z0-9@._+:-]+\.pkg\.tar\.(zst|xz|gz)$")

# Части системы: удалить из магазина нельзя. Остальное, на чём держится
# система, защищает сам pacman — от этих пакетов зависит sedmio-base.
PROTECTED = {"base", "pacman", "systemd", "glibc", "sudo", "linux-firmware", "kwin", "quickshell"}
PROTECTED_PREFIXES = ("sedmio-", "linux")


def out(line):
    print(line, flush=True)


def fail(code, message):
    out(f"ERROR {code} {message}")
    sys.exit(1 if code not in (3, 4) else code)


def protected(name):
    return name in PROTECTED or name.startswith(PROTECTED_PREFIXES)


def busy():
    if os.path.exists("/var/lib/pacman/db.lck"):
        return True
    return subprocess.run(["systemctl", "is-active", "--quiet", "sedmio-upgrade.service"]).returncode == 0


def explain(text):
    """Ошибка pacman (вывод на английском, LC_ALL=C) — по-русски, с кодом."""
    m = re.search(r"error: target not found: (\S+)", text)
    if m:
        return 4, (f"Пакета {m.group(1)} нет в базах. Возможно, они устарели — "
                   "обновите систему и попробуйте снова.")
    if "failed retrieving file" in text and ("404" in text or "not found" in text.lower()):
        return 4, ("Базы пакетов устарели: этой версии уже нет на зеркалах. "
                   "Обновите систему и попробуйте снова.")
    if "failed retrieving file" in text or "Could not resolve host" in text or "failed to retrieve some files" in text:
        return 1, "Не удалось скачать пакеты — проверьте интернет."
    m = re.search(r"removing (\S+) breaks dependency '[^']*' required by (\S+)", text)
    if m:
        needed = sorted(set(re.findall(r"required by (\S+)", text)))
        shown = ", ".join(needed[:4]) + (" и другие" if len(needed) > 4 else "")
        return 1, f"Нельзя удалить: без {m.group(1)} не будут работать {shown}."
    if "unable to satisfy dependency" in text or "could not satisfy dependencies" in text:
        return 4, "Не сходятся зависимости. Обновите систему и попробуйте снова."
    m = re.search(r"(\S+) and (\S+) are in conflict", text)
    if m:
        return 1, f"{m.group(1)} конфликтует с установленным {m.group(2)}. Сначала удалите {m.group(2)}."
    if "conflicting files" in text or "exists in filesystem" in text:
        return 1, "Файлы пакета уже лежат в системе (их поставили не через pacman). Подробности — в /run/sedmio-store/last.log."
    if "invalid or corrupted package" in text or "signature" in text and "invalid" in text:
        return 1, "Пакет скачался повреждённым или с неверной подписью. Попробуйте позже."
    if "Not enough free disk space" in text:
        return 1, "Не хватает места на диске."
    if "unable to lock database" in text:
        return 3, "Сейчас идёт другая установка или обновление — дождитесь конца."
    last = [l for l in text.strip().splitlines() if l.startswith("error:")]
    return 1, "pacman: " + (last[-1][7:] if last else "не получилось, подробности — в /run/sedmio-store/last.log")


def run_pacman(args, steps):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    env = dict(os.environ, LC_ALL="C", LANG="C")
    lines = []
    with open(LOG, "w") as log:
        os.chmod(LOG, 0o644)
        proc = subprocess.Popen(["pacman", *args], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                stdin=subprocess.DEVNULL, env=env, text=True, errors="replace")
        for line in proc.stdout:
            log.write(line)
            line = line.rstrip("\n")
            lines.append(line)
            steps(line)
        code = proc.wait()
    return code, "\n".join(lines)


class Steps:
    """Строки pacman → STEP и PROGRESS для магазина."""

    def __init__(self):
        self.total = 0
        self.done = 0

    def __call__(self, line):
        m = re.match(r"Packages? \((\d+)\)", line)
        if m:
            self.total = int(m.group(1))
        if line.startswith(":: Retrieving packages"):
            out("STEP Скачиваю")
        elif line.startswith(":: Running pre-transaction hooks"):
            out("STEP Снимок системы на случай отката")
        elif "checking package integrity" in line:
            out("STEP Проверяю пакеты")
        elif line.startswith(":: Running post-transaction hooks"):
            out("STEP Завершаю")
        # «installing foo...» (с --noconfirm без счётчика «(1/3)»).
        m = re.match(r"(?:\(\d+/\d+\) )?(installing|upgrading|reinstalling|removing) (\S+?)(?:\.\.\.)?$", line)
        if m:
            self.done += 1
            verb = "Удаляю" if m.group(1) == "removing" else "Устанавливаю"
            out(f"STEP {verb} {m.group(2)}")
            if self.total:
                out(f"PROGRESS {min(self.done, self.total)} {self.total}")


def take_files(paths):
    """Файлы пакетов от пользователя, вызвавшего pkexec, — к себе в AUR_CACHE.
    Пусть только из его ~/.cache/sedmio-store/aur и только его файлы."""
    uid = os.environ.get("PKEXEC_UID")
    if not uid or not uid.isdigit():
        print("store-helper: install-files — только через pkexec", file=sys.stderr)
        sys.exit(2)
    home = pwd.getpwuid(int(uid)).pw_dir
    allowed = os.path.realpath(os.path.join(home, ".cache/sedmio-store/aur")) + "/"
    os.makedirs(AUR_CACHE, mode=0o755, exist_ok=True)
    for old in os.listdir(AUR_CACHE):
        os.unlink(os.path.join(AUR_CACHE, old))
    taken = []
    for path in paths:
        real = os.path.realpath(path)
        name = os.path.basename(real)
        if not real.startswith(allowed) or not FILE_RE.match(name):
            print(f"store-helper: нельзя ставить {path}", file=sys.stderr)
            sys.exit(2)
        # Открываем без перехода по ссылкам и проверяем уже открытый файл:
        # подмени пользователь путь после проверки — прочитаем всё равно
        # только его собственный обычный файл.
        try:
            fd = os.open(real, os.O_RDONLY | os.O_NOFOLLOW)
        except OSError:
            print(f"store-helper: нет файла {path}", file=sys.stderr)
            sys.exit(2)
        with os.fdopen(fd, "rb") as src:
            st = os.fstat(src.fileno())
            if st.st_uid != int(uid) or not stat.S_ISREG(st.st_mode):
                print(f"store-helper: нельзя ставить {path}", file=sys.stderr)
                sys.exit(2)
            dest = os.path.join(AUR_CACHE, name)
            with open(dest, "wb") as out_file:
                shutil.copyfileobj(src, out_file)
        os.chmod(dest, 0o644)
        taken.append(dest)
    return taken


def main():
    args = sys.argv[1:]
    commands = ("install", "install-deps", "install-files", "remove")
    if len(args) < 2 or args[0] not in commands:
        print("store-helper install|install-deps|install-files|remove <пакет>...", file=sys.stderr)
        return 2
    command, rest = args[0], args[1:]
    as_deps = False
    if command == "install-files":
        if rest and rest[0] == "--asdeps":
            as_deps, rest = True, rest[1:]
        if not rest:
            return 2
    elif not all(NAME_RE.match(a) for a in rest):
        print("store-helper: неверное имя пакета", file=sys.stderr)
        return 2

    # Отдельной службой (см. начало файла). Внутри неё INVOCATION_ID задан.
    if not os.environ.get("INVOCATION_ID"):
        if command == "install-files":
            # Пока мы ещё знаем, кто позвал (PKEXEC_UID в службу не попадёт).
            rest = take_files(rest)
            args = [command] + (["--asdeps"] if as_deps else []) + rest
        os.execvp("systemd-run", ["systemd-run", "--wait", "--pipe", "--quiet", "--collect",
                                  "--service-type=exec", "-p", "KillMode=process",
                                  "--description=Sedmio: установка программ",
                                  "/usr/lib/sedmio/store-helper", *args])

    if busy():
        fail(3, "Сейчас идёт другая установка или обновление — дождитесь конца.")
    if command == "remove":
        blocked = [p for p in rest if protected(p)]
        if blocked:
            fail(1, f"{', '.join(blocked)} — часть системы, её нельзя удалить.")
        pacman_args = ["-Rs", "--noconfirm", "--color", "never", "--", *rest]
    elif command == "install-files":
        files = [os.path.realpath(p) for p in rest]
        if not all(os.path.dirname(f) == AUR_CACHE and FILE_RE.match(os.path.basename(f)) for f in files):
            fail(1, "Ставить можно только собранное магазином.")
        pacman_args = ["-U", "--noconfirm", "--noprogressbar", "--color", "never",
                       *(["--asdeps"] if as_deps else []), "--", *files]
    else:
        pacman_args = ["-S", "--needed", "--noconfirm", "--noprogressbar", "--color", "never",
                       *(["--asdeps"] if command == "install-deps" else []), "--", *rest]

    out("STEP Готовлю")
    code, text = run_pacman(pacman_args, Steps())
    if code != 0:
        fail(*explain(text))
    out("DONE")
    return 0


if __name__ == "__main__":
    sys.exit(main())
