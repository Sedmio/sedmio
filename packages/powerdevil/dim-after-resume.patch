+// Core deletes this action when no display supports brightness control any
+// more — e.g. KWin briefly has no outputs while resuming from suspend. The
+// dimming ratio lives on in ScreenBrightnessController and gets applied to
+// the displays once they come back, but a new DimDisplay starts undimmed and
+// never restores it: the screens stayed at 30% until powerdevil restarted.
+// Same as upstream MR !739 (bugs.kde.org 513809).
+DimDisplay::~DimDisplay()
+{
+    if (m_dimmed) {
+        qCDebug(POWERDEVIL) << "DimDisplay: restoring brightness on removal";
+        core()->screenBrightnessController()->setDimmingRatio(DIMMING_ID, 1.0);
+        setKeyboardBrightnessHelper(m_oldKeyboardBrightness);
+    }
+}
