# Память: «программа закрыта — не хватило памяти» и «память почти
# кончилась» (/usr/lib/sedmio/memwatch) вместо oom_notifier из
# plasma-workspace.
[Unit]
Description=Sedmio session: low memory warnings
PartOf=graphical-session.target
# Не After=graphical-session.target: та сама After=sedmio-session.target,
# а цель ждёт свои службы — замкнутый круг, и служба не запускалась.
After=sedmio-kwin.service

[Service]
ExecStart=/usr/lib/sedmio/memwatch
Restart=on-failure
RestartSec=5
Slice=background.slice
