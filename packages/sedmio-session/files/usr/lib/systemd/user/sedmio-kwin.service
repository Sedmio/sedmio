# Диспетчер окон KWin — основа сеанса Sedmio (sedmio-session.target).
# Обёртка перезапускает упавший KWin сама, программы переподключаются
# (QT_WAYLAND_RECONNECT); кончилась обёртка — кончился сеанс.
[Unit]
Description=Sedmio session: KWin
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/kwin_wayland_wrapper --xwayland
# Готова, когда обёртка заняла имя на шине, — к этому времени сокет
# Wayland уже есть. Без этого заставка, оболочка и session-manager,
# идущие After= этой службы, стартовали раньше KWin и падали без
# экрана. То же имя заявляет plasma-kwin_wayland.service (пакет kwin),
# и systemd при перезагрузке настроек пишет об этом предупреждение —
# оно безвредно.
Type=dbus
BusName=org.kde.KWinWrapper
Slice=session.slice
