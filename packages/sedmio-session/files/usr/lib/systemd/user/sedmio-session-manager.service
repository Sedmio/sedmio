# Выход из сеанса, выключение и перезагрузка: экран «Что сделать?»
# (Ctrl+Alt+Del, кнопка питания, меню оболочки) и службы D-Bus
# org.kde.LogoutPrompt и org.kde.Shutdown, которые зовут программы KDE и
# powerdevil. Отдельно от оболочки: упадёт панель — выключить компьютер
# всё равно можно.
[Unit]
Description=Sedmio session: logout and shutdown
PartOf=graphical-session.target
After=sedmio-kwin.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
ExecStart=/usr/lib/sedmio/session-manager
Restart=on-failure
RestartSec=1
Slice=session.slice
