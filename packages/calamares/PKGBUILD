# Maintainer: Sedmio <https://github.com/Sedmio>
#
# Calamares из исходников, с QML-модулями (welcomeq, localeq, usersq,
# summaryq, finishedq), на которых сделаны страницы установщика Sedmio.
# Пакет cachyos-calamares собран без них, поэтому собираем свой.
#
# Основа — PKGBUILD из AUR (calamares). Настройки по умолчанию ставятся
# в /usr/share/calamares, наши лежат в /etc/calamares (пакет sedmio-calamares)
# и имеют приоритет.

pkgname=calamares
pkgver=3.4.3
pkgrel=5
pkgdesc="Distribution-independent installer framework (сборка Sedmio, с QML-модулями)"
arch=('x86_64')
url="https://codeberg.org/Calamares/calamares"
license=('GPL-3.0-or-later')
depends=(
  'kcoreaddons'
  'kpmcore'
  'libpwquality'
  'qt6-declarative'
  'qt6-svg'
  'yaml-cpp'
  'python'
  'parted'      # проверка свободного места на странице приветствия

  # нужны модулям во время установки
  'ckbcomp'
  'cryptsetup'
  'dmidecode'
  'gptfdisk'
  'rsync'
  'squashfs-tools'
  'upower'
)
makedepends=(
  'extra-cmake-modules'
  'parted'
  'libglvnd'
  'ninja'
  'qt6-tools'
  'qt6-translations'
)
conflicts=('cachyos-calamares')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
        'failure-dialog.patch'
        'sedmio-look.patch'
        'python-status.patch')
sha256sums=('144cbbf6bdcebfb21685950db4f0777218519df095f62f4aa392f28348110d18'
            '9bb98028f222a4304efc8bf3c738d970183639c7a76ad4d19947ae21231c1b0f'
            '2aa7b4e09a46584da729d15c81111b11642712364950d6541a016d4a780f4b37'
            'c151c78bbda2c32701ae9b849df8015dc5439eaab6088f9bc3d57d7a9bf4a9f4')

prepare() {
  # Без отдельного окна ошибки: её показывает страница finishedq,
  # а закрытие того окна завершало установщик.
  patch -d "$pkgname-$pkgver" -p1 < failure-dialog.patch

  # Страница разметки (она на виджетах, не на QML) в стиле Sedmio:
  # заголовок как у остальных страниц, палитра полос разделов, мягкий
  # красный вместо red, без значков «EFI» и «тип таблицы разделов».
  # Там же страница хода установки: поля как у остальных, кнопка
  # «Журнал» вместо непереведённой «Toggle log».
  # Стили подписей — в branding/sedmio/stylesheet.qss.
  patch -d "$pkgname-$pkgver" -p1 < sedmio-look.patch

  # Подпись под полосой хода от Python-модулей: в сборке с pybind11
  # Calamares не вызывал pretty_status_message() (там стоит TODO), и
  # вместо «Скачиваем программы: 512 из 2183 МБ» весь шаг висело его
  # название. Теперь — как в сборке с Boost::Python: при каждом
  # setprogress() подпись берётся из pretty_status_message().
  patch -d "$pkgname-$pkgver" -p1 < python-status.patch

  # Свои значки вариантов разметки и дисков (icons/, 48×48, палитра
  # Sedmio) вместо значков KDE; вшиваются в libcalamaresui.
  # Не в source=(): makepkg ищет локальные файлы только рядом с PKGBUILD.
  cp "$startdir"/icons/*.svg "$pkgname-$pkgver/data/images/"
}

build() {
  local skip_modules=(
    dracut
    dracutlukscfg
    dummycpp
    dummyprocess
    dummypython
    dummypythonqt
    initramfs
    initramfscfg
    interactiveterminal
    packagechooser
    packagechooserq
    services-openrc
  )

  cmake -B build -S "$pkgname-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DKDE_INSTALL_SYSCONFDIR=/etc \
    -DKDE_INSTALL_LIBEXECDIR=/usr/libexec \
    -DWITH_QT6=ON \
    -DINSTALL_CONFIG=ON \
    -DSKIP_MODULES="${skip_modules[*]}" \
    -DBUILD_TESTING=OFF \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
